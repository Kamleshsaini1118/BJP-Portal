<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===================== COLOR PALETTE ===================== -->
    <Color x:Key="SaffronColor">#FF9933</Color>
    <Color x:Key="SaffronDeepColor">#E2600A</Color>
    <Color x:Key="SaffronDarkColor">#B84A08</Color>
    <Color x:Key="GreenColor">#138808</Color>
    <Color x:Key="GreenDeepColor">#0C6606</Color>
    <Color x:Key="NavyColor">#0B1F3A</Color>
    <Color x:Key="CreamColor">#FFF8F0</Color>
    <Color x:Key="PaperColor">#FFFFFF</Color>
    <Color x:Key="InkColor">#20170F</Color>
    <Color x:Key="InkSoftColor">#6B5B4E</Color>
    <Color x:Key="LineColor">#F0E2D2</Color>
    <Color x:Key="ErrorColor">#B03A2E</Color>

    <SolidColorBrush x:Key="SaffronBrush" Color="{StaticResource SaffronColor}"/>
    <SolidColorBrush x:Key="SaffronDeepBrush" Color="{StaticResource SaffronDeepColor}"/>
    <SolidColorBrush x:Key="SaffronDarkBrush" Color="{StaticResource SaffronDarkColor}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="GreenDeepBrush" Color="{StaticResource GreenDeepColor}"/>
    <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource CreamColor}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Left panel gradient -->
    <LinearGradientBrush x:Key="IdentityGradient" StartPoint="0,0" EndPoint="0.65,1">
        <GradientStop Color="{StaticResource SaffronColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource SaffronDeepColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource SaffronDarkColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Primary button gradient -->
    <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource SaffronColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource SaffronDeepColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Sidebar gradient -->
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource SaffronDarkColor}" Offset="0.0"/>
        <GradientStop Color="#7A3306" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- User avatar gradient -->
    <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource SaffronColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource SaffronDeepColor}" Offset="1.0"/>
    </LinearGradientBrush>
</ResourceDictionary>
