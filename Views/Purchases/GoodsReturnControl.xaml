<UserControl x:Class="StockPortalApp.Views.Purchases.GoodsReturnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="1180">

    <Border Background="White"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Actions -->
                <RowDefinition Height="Auto"/> <!-- Divider -->
                <RowDefinition Height="Auto"/> <!-- Filter Strip -->
                <RowDefinition Height="Auto"/> <!-- Summary Badge -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- HEADER & ACTION BAR -->
            <Grid Grid.Row="0" Margin="22,18,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Returns to Vendor"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Record goods sent back to a vendor against the purchase they came from. Returns reduce what you owe that vendor in the Vendor Ledger and appear in the Day Book."
                               FontSize="12"
                               Foreground="{StaticResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Width="220"
                            Height="36"
                            Background="#FFFCF9"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="10,0"
                            Margin="0,0,10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="M10 17 A7 7 0 1 1 17 10 A7 7 0 0 1 10 17 Z M15 15 L20 20"
                                  Stroke="{StaticResource InkSoftBrush}"
                                  StrokeThickness="1.6"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,7,0"
                                  VerticalAlignment="Center"/>

                            <Grid Grid.Column="1">
                                <TextBlock Text="Search returns, vendors, items..."
                                           Visibility="{Binding Text, ElementName=ReturnSearchBox, Converter={StaticResource StringToVisibilityConverter}}"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="ReturnSearchBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="12.5"
                                         Foreground="{StaticResource InkBrush}"
                                         VerticalContentAlignment="Center"
                                         Padding="0"
                                         TextChanged="ReturnSearchBox_TextChanged"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Content="Export to Excel"
                            Style="{StaticResource OutlineButton}"
                            Padding="14,5"
                            Height="36"
                            FontSize="12.5"
                            Margin="0,0,10,0"
                            Click="ExportExcelButton_Click"/>

                    <Button Content="+ Return to Vendor"
                            Style="{StaticResource MiniButton}"
                            Padding="16,5"
                            Height="36"
                            FontSize="12.5"
                            Click="AddReturnButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource LineBrush}"/>

            <!-- FILTER STRIP -->
            <Border Grid.Row="2"
                    Background="#FFFBF7"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="22,12,22,6">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- VENDOR -->
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="VENDOR"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="VendorFilterCombo"
                                  Width="165"
                                  Height="36"
                                  FontSize="12.5"
                                  Style="{StaticResource RoundedComboBox}"
                                  Cursor="Hand"
                                  SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- CATEGORY -->
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="CATEGORY"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CategoryFilterCombo"
                                  Width="150"
                                  Height="36"
                                  FontSize="12.5"
                                  Style="{StaticResource RoundedComboBox}"
                                  Cursor="Hand"
                                  SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- PRODUCT -->
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="PRODUCT"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="ProductFilterCombo"
                                  Width="160"
                                  Height="36"
                                  FontSize="12.5"
                                  Style="{StaticResource RoundedComboBox}"
                                  Cursor="Hand"
                                  SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- REASON -->
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="REASON"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="ReasonFilterCombo"
                                  Width="145"
                                  Height="36"
                                  FontSize="12.5"
                                  Style="{StaticResource RoundedComboBox}"
                                  Cursor="Hand"
                                  SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- FROM DATE -->
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="FROM DATE"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,5"/>
                        <DatePicker x:Name="FromDatePicker"
                                    Width="135"
                                    Height="36"
                                    FontSize="12.5"
                                    Language="en-IN"
                                    Style="{StaticResource RoundedDatePicker}"
                                    Cursor="Hand"
                                    SelectedDateChanged="DateFilterChanged"/>
                    </StackPanel>

                    <!-- TO DATE -->
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="TO DATE"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,5"/>
                        <DatePicker x:Name="ToDatePicker"
                                    Width="135"
                                    Height="36"
                                    FontSize="12.5"
                                    Language="en-IN"
                                    Style="{StaticResource RoundedDatePicker}"
                                    Cursor="Hand"
                                    SelectedDateChanged="DateFilterChanged"/>
                    </StackPanel>

                    <!-- CLEAR FILTERS -->
                    <Button Content="Clear Filters"
                            Style="{StaticResource OutlineButton}"
                            Height="36"
                            Padding="16,0"
                            FontSize="12.5"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,8"
                            Click="ClearFiltersButton_Click"/>
                </WrapPanel>
            </Border>

            <!-- SUMMARY PILL -->
            <Border Grid.Row="3"
                    Background="White"
                    Padding="22,10,22,8">
                <Border HorizontalAlignment="Right"
                        Background="#FFF0DE"
                        CornerRadius="999"
                        Padding="14,5">
                    <TextBlock x:Name="SummaryBadgeText"
                               Text="0 returns · Qty: 0 · Amount: ₹0"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Border>

            <!-- DATA GRID -->
            <Grid Grid.Row="4">
                <DataGrid x:Name="ReturnsGrid"
                          Style="{StaticResource AppDataGrid}"
                          MinRowHeight="52">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="RETURN NO." MinWidth="110" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFEAFE"
                                            CornerRadius="6"
                                            Padding="9,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReturnNo}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="#5B21B6"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="RETURN DATE"
                                            Binding="{Binding ReturnDateDisplay}"
                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                            MinWidth="110"
                                            Width="0.95*"/>

                        <DataGridTextColumn Header="VENDOR"
                                            Binding="{Binding VendorName}"
                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                            MinWidth="150"
                                            Width="1.35*"/>

                        <DataGridTemplateColumn Header="AGAINST PURCHASE" MinWidth="140" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                                        <TextBlock Text="{Binding AgainstPurchaseRef}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"/>
                                        <TextBlock Text="{Binding PurchaseDateDisplay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Visibility="{Binding HasPurchaseDate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ITEMS"
                                            Binding="{Binding ItemsDisplay}"
                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                            MinWidth="180"
                                            Width="1.7*"/>

                        <DataGridTextColumn Header="REASON"
                                            Binding="{Binding Reason}"
                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                            MinWidth="105"
                                            Width="0.9*"/>

                        <DataGridTemplateColumn Header="AMOUNT" MinWidth="100" Width="0.85*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalAmountDisplay}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACTIONS" MinWidth="120" Width="0.95*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Return Note"
                                            Style="{StaticResource OutlineButton}"
                                            Padding="12,5"
                                            FontSize="12"
                                            HorizontalAlignment="Left"
                                            Click="ReturnNoteButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyStateText"
                           Text="No goods returns recorded yet. Click &quot;+ Return to Vendor&quot; to create one."
                           Style="{StaticResource PlaceholderText}"
                           FontSize="14"
                           Margin="24"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
