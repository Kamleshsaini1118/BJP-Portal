<Window x:Class="StockPortalApp.Views.Purchases.AddGoodsReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Return to Vendor"
        Width="940"
        SizeToContent="Height"
        MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Header Bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M9 14L4 9L9 4"
                                      Stroke="{StaticResource SaffronDeepBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M4 9H15C18.3 9 21 11.7 21 15C21 18.3 18.3 21 15 21H11"
                                      Stroke="{StaticResource SaffronDeepBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Return to Vendor"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18.5"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Pick the purchase the goods came from, then enter how many of each item are going back."
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFF5EC"
                            BorderBrush="#F0D5C0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Goods Return"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- <Button Style="{StaticResource WindowControlButton}"
                            Click="CancelButton_Click"
                            ToolTip="Close">
                        <Path Data="M6 6L18 18M18 6L6 18"
                              Stroke="{StaticResource InkSoftBrush}"
                              StrokeThickness="1.8"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"/>
                    </Button> -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Body -->
        <ScrollViewer x:Name="BodyScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,18">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,20">
                <StackPanel>
                    <!-- Row 1: Vendor & Against Purchase -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Vendor"/>
                                <Run Text=" *" Foreground="{StaticResource ErrorBrush}"/>
                            </TextBlock>
                            <ComboBox x:Name="VendorCombo"
                                      Style="{StaticResource RoundedComboBox}"
                                      Height="40"
                                      Tag="Select vendor"
                                      Cursor="Hand"
                                      SelectionChanged="VendorCombo_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Against Purchase"/>
                                <Run Text=" *" Foreground="{StaticResource ErrorBrush}"/>
                            </TextBlock>
                            <ComboBox x:Name="PurchaseCombo"
                                      Style="{StaticResource RoundedComboBox}"
                                      Height="40"
                                      Tag="Select vendor first"
                                      IsEnabled="False"
                                      Cursor="Hand"
                                      SelectionChanged="PurchaseCombo_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Return Date & Reason -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Return Date"/>
                                <Run Text=" *" Foreground="{StaticResource ErrorBrush}"/>
                            </TextBlock>
                            <DatePicker x:Name="ReturnDatePicker"
                                        Style="{StaticResource RoundedDatePicker}"
                                        Height="40"
                                        Language="en-IN"
                                        Cursor="Hand"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Reason"/>
                                <Run Text=" *" Foreground="{StaticResource ErrorBrush}"/>
                            </TextBlock>
                            <ComboBox x:Name="ReasonCombo"
                                      Style="{StaticResource RoundedComboBox}"
                                      Height="40"
                                      Tag="Select reason"
                                      Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- ITEMS TO RETURN -->
                    <TextBlock Text="ITEMS TO RETURN"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,8"/>

                    <Border BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="White"
                            ClipToBounds="True">
                        <StackPanel>
                            <!-- Table Header -->
                            <Border Background="#FBF5EE"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="0.65*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ITEM" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                                    <TextBlock Grid.Column="1" Text="PURCHASED" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="RETURNED EARLIER" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="CAN RETURN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="RETURN QTY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" TextAlignment="Center" Margin="8,0"/>
                                    <TextBlock Grid.Column="5" Text="RATE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="GST" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="AMOUNT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" TextAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Empty / Prompt State -->
                            <TextBlock x:Name="ItemsEmptyText"
                                       Text="Select a vendor and purchase to list its items."
                                       FontSize="13"
                                       Foreground="{StaticResource InkSoftBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="16,24"
                                       Visibility="Visible"/>

                            <!-- Items List -->
                            <ItemsControl x:Name="ReturnItemsControl" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,10">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="1.15*"/>
                                                    <ColumnDefinition Width="0.95*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="0.65*"/>
                                                    <ColumnDefinition Width="0.95*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ProductName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ItemMetaDisplay}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource InkSoftBrush}"
                                                               Visibility="{Binding HasItemMeta, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PurchasedDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource InkBrush}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ReturnedEarlierDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"/>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding CanReturnDisplay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource GreenDeepBrush}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"/>

                                                <TextBox Grid.Column="4"
                                                         Text="{Binding ReturnQtyText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CanEdit}"
                                                         Height="34"
                                                         Margin="8,0"
                                                         Padding="8,4"
                                                         FontSize="13"
                                                         HorizontalContentAlignment="Center"
                                                         Tag="0"
                                                         Loaded="ReturnQtyBox_Loaded">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                                                    <Setter Property="Background" Value="#FFF5F5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding RateDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource InkBrush}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"/>

                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding GstDisplay}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"/>

                                                <TextBlock Grid.Column="7"
                                                           Text="{Binding LineAmountDisplay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource InkBrush}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Return Amount Total -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,16">
                        <TextBlock Text="Return Amount: "
                                   FontSize="13.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ReturnAmountText"
                                   Text="₹0"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Optional Fields Row 1 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Handed Over To (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HandedOverToBox"
                                     Style="{StaticResource RoundedTextBox}"
                                     Height="40"
                                     Tag="e.g. Vendor's delivery person"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contact Number (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ContactNumberBox"
                                     Style="{StaticResource RoundedTextBox}"
                                     Height="40"
                                     MaxLength="15"
                                     Tag="e.g. 98XXXXXXXX"/>
                        </StackPanel>
                    </Grid>

                    <!-- Remarks -->
                    <StackPanel>
                        <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RemarksBox"
                                 Style="{StaticResource RoundedTextBox}"
                                 Height="40"
                                 Tag="e.g. 20 kits found torn on unloading"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        Height="38"
                        Padding="18,0"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton"
                        Content="Save Return"
                        Style="{StaticResource MiniButton}"
                        Height="38"
                        Padding="22,0"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
