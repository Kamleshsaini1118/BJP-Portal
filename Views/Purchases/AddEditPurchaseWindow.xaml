<Window x:Class="StockPortalApp.AddEditPurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Purchase"
        Width="920"
        SizeToContent="Height"
        MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Accent Line -->
            <RowDefinition Height="Auto"/> <!-- Header Bar -->
            <RowDefinition Height="*"/>    <!-- Form Card Body -->
            <RowDefinition Height="Auto"/> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Header Bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Shopping Cart / Purchase Icon Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                              Fill="{StaticResource SaffronDeepBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle"
                                   Text="Add Purchase"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18.5"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Record a completed purchase — with or without a PO reference."
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Side Tag Badge & Active Close Button -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#FFF5EC"
                            BorderBrush="#F0D5C0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Purchase Log"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Active Close Button -->
                    <!-- <Button Click="CancelButton_Click"
                            Cursor="Hand"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="6">
                                    <TextBlock Text="✕"
                                               FontSize="15"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#12000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button> -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer x:Name="BodyScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="560">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="22,18"
                    Padding="24,20">
                <StackPanel>

                    <!-- Purchase Type Selector -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Purchase Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TypeCombo"
                                  MinHeight="40"
                                  Padding="12,0"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource SearchableComboBox}"
                                  SelectionChanged="TypeCombo_SelectionChanged"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <!-- ===== PURCHASE DETAILS (shown once a type is picked) ===== -->
                    <StackPanel x:Name="PurchaseDetailsSection" Visibility="Collapsed">
                        <TextBlock Text="PURCHASE DETAILS"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Row 1: PO Reference, Received Against, Purchase Date -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PO Reference (optional)" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="PoRefCombo"
                                          MinHeight="40"
                                          Padding="12,0"
                                          FontSize="14"
                                          VerticalContentAlignment="Center"
                                          Style="{StaticResource SearchableComboBox}"
                                          Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Received Against" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ReceiptBasisCombo"
                                          MinHeight="40"
                                          Padding="12,0"
                                          FontSize="14"
                                          VerticalContentAlignment="Center"
                                          Style="{StaticResource SearchableComboBox}"
                                          SelectionChanged="ReceiptBasisCombo_SelectionChanged"
                                          Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Purchase Date" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="PurchaseDatePicker"
                                            MinHeight="40"
                                            Padding="10,0"
                                            FontSize="14"
                                            VerticalContentAlignment="Center"
                                            Language="en-IN"
                                            Style="{StaticResource RoundedDatePicker}"
                                            Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Invoice/Challan Number & Vendor -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="InvoiceNumberLabel" Text="Invoice Number" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="InvoiceBox"
                                         MinHeight="40"
                                         Padding="12,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Tag="e.g. INV-90812"
                                         Style="{StaticResource RoundedTextBox}"/>

                                <TextBlock x:Name="ChallanNumberLabel" Text="Challan Number" Style="{StaticResource FieldLabel}" Visibility="Collapsed"/>
                                <TextBox x:Name="ChallanNumberBox"
                                         MinHeight="40"
                                         Padding="12,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Tag="e.g. CH-4412"
                                         Style="{StaticResource RoundedTextBox}"
                                         Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vendor" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="VendorCombo"
                                          MinHeight="40"
                                          Padding="12,0"
                                          FontSize="14"
                                          VerticalContentAlignment="Center"
                                          Style="{StaticResource SearchableComboBox}"
                                          SelectionChanged="VendorCombo_SelectionChanged"
                                          Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Challan Date Row -->
                        <Grid x:Name="ChallanDateRow" Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Challan Date" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="ChallanDatePicker"
                                            MinHeight="40"
                                            Padding="10,0"
                                            FontSize="14"
                                            VerticalContentAlignment="Center"
                                            Language="en-IN"
                                            Style="{StaticResource RoundedDatePicker}"
                                            Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Challan Hint Box -->
                        <Border x:Name="ChallanHintBorder"
                                Visibility="Collapsed"
                                Background="#FFF5EC"
                                BorderBrush="#F0D5C0"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,12"
                                Margin="0,0,0,20">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource InkSoftBrush}" LineHeight="18">
                                Goods received on challan basis — no invoice yet. When the vendor's invoice arrives, use <Run FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}" Text="Combine Challans"/> on the Purchases dashboard to link them.
                            </TextBlock>
                        </Border>

                        <TextBlock Text="PURCHASE ITEMS"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Items Table Header -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CATEGORY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Cursor="Hand"/>
                            <TextBlock Grid.Column="2" Text="PRODUCT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Cursor="Hand"/>
                            <TextBlock Grid.Column="4" Text="QTY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                            <TextBlock Grid.Column="6" Text="PRICE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                            <TextBlock Grid.Column="8" Text="GST %" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Cursor="Hand"/>
                            <TextBlock Grid.Column="10" Text="TOTAL" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                        </Grid>

                        <!-- Items Table Rows -->
                        <ItemsControl x:Name="PurchaseItemRowsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  MinHeight="36"
                                                  Padding="10,0"
                                                  FontSize="13"
                                                  VerticalContentAlignment="Center"
                                                  Style="{StaticResource SearchableComboBox}"
                                                  ItemsSource="{Binding CategoryNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ComboBox Grid.Column="2"
                                                  MinHeight="36"
                                                  Padding="10,0"
                                                  FontSize="13"
                                                  VerticalContentAlignment="Center"
                                                  Style="{StaticResource SearchableComboBox}"
                                                  ItemsSource="{Binding AvailableItems}"
                                                  SelectedItem="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBox Grid.Column="4"
                                                 MinHeight="36"
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 Style="{StaticResource RoundedTextBox}"
                                                 Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBox Grid.Column="6"
                                                 MinHeight="36"
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 Style="{StaticResource RoundedTextBox}"
                                                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ComboBox Grid.Column="8"
                                                  MinHeight="36"
                                                  Padding="10,0"
                                                  FontSize="13"
                                                  VerticalContentAlignment="Center"
                                                  Style="{StaticResource SearchableComboBox}"
                                                  ItemsSource="{Binding GstOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding GstPercent, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBox Grid.Column="10"
                                                 MinHeight="36"
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 Style="{StaticResource RoundedTextBox}"
                                                 IsReadOnly="True"
                                                 Background="#FFFBF7"
                                                 Foreground="{StaticResource InkSoftBrush}"
                                                 Text="{Binding TotalDisplay, Mode=OneWay}"/>

                                        <Button Grid.Column="12"
                                                Content="✕"
                                                Width="26"
                                                Height="26"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource InkSoftBrush}"
                                                Cursor="Hand"
                                                Click="RemovePurchaseItemButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Item Button -->
                        <Button Content="+ Add Item"
                                Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Left"
                                Padding="14,6"
                                Height="34"
                                FontSize="12.5"
                                Margin="0,4,0,16"
                                Click="AddPurchaseItemButton_Click"/>

                        <!-- Grand Total Summary Banner -->
                        <Border Background="#FFF5EC"
                                BorderBrush="#F0D5C0"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="16,12"
                                Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Grand Total: "
                                           Foreground="{StaticResource InkSoftBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13.5"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="GrandTotalText"
                                           Text="₹0.00"
                                           FontFamily="{StaticResource HeadingFont}"
                                           Foreground="{StaticResource InkBrush}"
                                           FontWeight="Bold"
                                           FontSize="17"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="INVOICE FILE ATTACHMENTS (OPTIONAL)"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- File Dropzone Button -->
                        <Button x:Name="AttachInvoiceFilesButton"
                                Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Stretch"
                                Padding="16,14"
                                Margin="0,0,0,12"
                                Click="AttachInvoiceFilesButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M12 18v-6 M9 15l3-3 3 3"
                                      Stroke="{StaticResource SaffronDeepBrush}"
                                      StrokeThickness="1.6"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Click to attach invoice files (PDF, PNG, JPG)"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ItemsControl x:Name="InvoiceFilesControl" Margin="0,0,0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF5EC"
                                            BorderBrush="#F0D5C0"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="12,5,8,5"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="180"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Content="✕"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="6,0,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{StaticResource InkSoftBrush}"
                                                    Cursor="Hand"
                                                    Click="RemoveInvoiceFileButton_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="RECEIVER &amp; PAYMENT DETAILS"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Receiver Name & Contact -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Receiver Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ReceiverNameBox"
                                         MinHeight="40"
                                         Padding="12,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Tag="e.g. Ramesh Kumar"
                                         Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Receiver Contact Number" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ReceiverNumberBox"
                                         MinHeight="40"
                                         Padding="12,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Tag="e.g. 9876543210"
                                         Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Payment Mode & Remarks -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Payment Mode" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PaymentModeBox"
                                         MinHeight="40"
                                         Padding="12,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Tag="e.g. Bank Transfer / UPI / Cash"
                                         Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RemarksBox"
                                         MinHeight="40"
                                         Padding="12,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Tag="Notes regarding payment or delivery..."
                                         Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ===== DISTRIBUTION DETAILS (Direct purchases only) ===== -->
                    <StackPanel x:Name="DistributionDetailsSection" Visibility="Collapsed" Margin="0,20,0,0">
                        <TextBlock Text="DISTRIBUTION DETAILS"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Distribute To & Dispatch Date -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Distribute To" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DestinationCombo"
                                          MinHeight="40"
                                          Padding="12,0"
                                          FontSize="14"
                                          VerticalContentAlignment="Center"
                                          Style="{StaticResource SearchableComboBox}"
                                          SelectionChanged="DestinationCombo_SelectionChanged"
                                          Cursor="Hand"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dispatch Date" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="DispatchDatePicker"
                                            MinHeight="40"
                                            Padding="10,0"
                                            FontSize="14"
                                            VerticalContentAlignment="Center"
                                            Language="en-IN"
                                            Style="{StaticResource RoundedDatePicker}" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="DISTRIBUTION ITEMS"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CATEGORY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Cursor="Hand"/>
                            <TextBlock Grid.Column="2" Text="ITEM" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Cursor="Hand"/>
                            <TextBlock Grid.Column="4" Text="QTY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                        </Grid>

                        <ItemsControl x:Name="DistItemRowsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  MinHeight="36"
                                                  Padding="10,0"
                                                  FontSize="13"
                                                  VerticalContentAlignment="Center"
                                                  Style="{StaticResource SearchableComboBox}"
                                                  ItemsSource="{Binding CategoryNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ComboBox Grid.Column="2"
                                                  MinHeight="36"
                                                  Padding="10,0"
                                                  FontSize="13"
                                                  VerticalContentAlignment="Center"
                                                  Style="{StaticResource SearchableComboBox}"
                                                  ItemsSource="{Binding AvailableItems}"
                                                  SelectedItem="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBox Grid.Column="4"
                                                 MinHeight="36"
                                                 Padding="10,0"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 Style="{StaticResource RoundedTextBox}"
                                                 Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"/>

                                        <Button Grid.Column="6"
                                                Content="✕"
                                                Width="26"
                                                Height="26"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource InkSoftBrush}"
                                                Cursor="Hand"
                                                Click="RemoveDistItemButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Add Item"
                                Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Left"
                                Padding="14,6"
                                Height="34"
                                FontSize="12.5"
                                Margin="0,4,0,20"
                                Click="AddDistItemButton_Click"/>

                        <TextBlock Text="DISTRIBUTION RECEIVER DETAILS"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
