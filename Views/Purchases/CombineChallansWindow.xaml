<Window x:Class="StockPortalApp.CombineChallansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Combine Challans into Invoice"
        Width="640"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Accent Line -->
            <RowDefinition Height="Auto"/> <!-- Header Bar -->
            <RowDefinition Height="*"/>    <!-- Form Card Body -->
            <RowDefinition Height="Auto"/> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Header Bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Receipt / Invoice Icon Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                              Stroke="{StaticResource SaffronDeepBrush}"
                              StrokeThickness="1.8"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Combine Challans into Invoice"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18.5"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Select the vendor's pending challan receipts to group into a master invoice."
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Side Tag Badge & Active Close Button -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#FFF5EC"
                            BorderBrush="#F0D5C0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Combine Challans"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Active Close Button -->
                    <!-- <Button Click="CancelButton_Click"
                            Cursor="Hand"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="6">
                                    <TextBlock Text="✕"
                                               FontSize="15"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#12000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button> -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer x:Name="BodyScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="540">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="22,18"
                    Padding="24,20">
                <StackPanel>

                    <!-- Vendor Selector -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Select Vendor" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="VendorCombo"
                                  MinHeight="40"
                                  Padding="12,0"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource SearchableComboBox}"
                                  SelectionChanged="VendorCombo_SelectionChanged"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock Text="PENDING CHALLANS"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,12"/>

                    <!-- Empty Hint Text -->
                    <TextBlock x:Name="EmptyHintText"
                               Text="Select a vendor to view their pending challans."
                               Foreground="{StaticResource InkSoftBrush}"
                               FontSize="13"
                               FontStyle="Italic"
                               Margin="0,0,0,16"/>

                    <!-- Challans List -->
                    <ItemsControl x:Name="ChallanListControl" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Background="#FFFCF9"
                                        Padding="14,12"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource InkBrush}">
                                                <Run Text="Challan #"/>
                                                <Run Text="{Binding Challan.ChallanNumber, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{StaticResource InkSoftBrush}" Margin="0,3,0,0">
                                                <Run Text="{Binding Challan.ChallanDateDisplay, Mode=OneWay}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding Challan.ItemsList, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Challan.TotalDisplay, Mode=OneWay}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="14.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Selection Summary Bar -->
                    <Border x:Name="SummaryBar"
                            Background="#FFF5EC"
                            BorderBrush="#F0D5C0"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="16,12"
                            Margin="0,0,0,20"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedCountText"
                                       Grid.Column="0"
                                       Text="0 selected"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{StaticResource SaffronDeepBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SelectedTotalText"
                                       Grid.Column="1"
                                       Text="₹0.00"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{StaticResource InkBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="INVOICE DETAILS"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,12"/>

                    <!-- Invoice Number & Date Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Invoice Number" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="InvoiceNumberBox"
                                     MinHeight="40"
                                     Padding="12,0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Tag="e.g. INV-2026-089"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Invoice Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="InvoiceDatePicker"
                                        MinHeight="40"
                                        Padding="10,0"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Language="en-IN"
                                        Style="{StaticResource RoundedDatePicker}"
                                        Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Remarks -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RemarksBox"
                                 MinHeight="68"
                                 Padding="12,8"
                                 FontSize="13.5"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Tag="Any notes regarding this invoice link..."
                                 Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>

                    <TextBlock Text="INVOICE FILE ATTACHMENT (OPTIONAL)"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,12"/>

                    <!-- File Dropzone Button -->
                    <Button x:Name="AttachFilesButton"
                            Style="{StaticResource OutlineButton}"
                            HorizontalAlignment="Stretch"
                            Padding="16,14"
                            Margin="0,0,0,12"
                            Click="AttachFilesButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M12 18v-6 M9 15l3-3 3 3"
                                  Stroke="{StaticResource SaffronDeepBrush}"
                                  StrokeThickness="1.6"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Click to upload invoice document (PDF, PNG, JPG)"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- File Chip Tags Container -->
                    <ItemsControl x:Name="InvoiceFilesControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF5EC"
                                        BorderBrush="#F0D5C0"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="12,5,8,5"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Content="✕"
                                                Width="20"
                                                Height="20"
                                                Margin="6,0,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource InkSoftBrush}"
                                                Cursor="Hand"
                                                Click="RemoveFileButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        Padding="22,9"
                        Height="38"
                        FontSize="13"
                        Margin="0,0,12,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="Save Invoice &amp; Link Challans"
                        Style="{StaticResource PrimaryButton}"
                        Padding="28,9"
                        Height="38"
                        FontSize="13"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>