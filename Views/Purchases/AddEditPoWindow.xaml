<Window x:Class="StockPortalApp.AddEditPoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StockPortalApp.Helpers"
        Title="Add PO"
        Width="940" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PO Icon Badge -->
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FFF5EC" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z" 
                              Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="Add PO" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Create or update purchase order details and route for processing." FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1" Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="Purchase Order" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="22,16" Padding="22,18">
                <StackPanel>

                    <TextBlock Text="VENDOR SELECTION" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12"/>

                    <!-- Vendor Combo -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Vendor" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="VendorCombo" Style="{StaticResource RoundedComboBox}"
                                  SelectionChanged="VendorCombo_SelectionChanged" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Add Vendor Row (Inline Creator) -->
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,2,0,14"/>

                    <TextBlock Text="ORDER ITEMS" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,10"/>

                    <!-- Column Headers -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CATEGORY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                        <TextBlock Grid.Column="2" Text="ITEM" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                        <TextBlock Grid.Column="4" Text="QTY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                        <TextBlock Grid.Column="6" Text="PRICE (₹)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                        <TextBlock Grid.Column="8" Text="GST (%)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Cursor="Hand"/>
                        <TextBlock Grid.Column="10" Text="TOTAL (₹)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                    </Grid>

                    <!-- Items Control with Row Placeholders -->
                    <ItemsControl x:Name="ItemRowsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category ComboBox -->
                                    <ComboBox Grid.Column="0" Style="{StaticResource RoundedComboBox}" Height="36" Padding="10,6" FontSize="12.5"
                                              ItemsSource="{Binding CategoryNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Item ComboBox -->
                                    <ComboBox Grid.Column="2" Style="{StaticResource RoundedComboBox}" Height="36" Padding="10,6" FontSize="12.5"
                                              ItemsSource="{Binding AvailableItems}"
                                              SelectedItem="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Qty Field with Placeholder -->
                                    <Grid Grid.Column="4">
                                        <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="8"/>
                                        <TextBlock Text="Qty" Foreground="{StaticResource InkSoftBrush}" FontSize="12.5" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Qty}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Qty}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox helpers:NumericInput.Mode="DigitsOnly" Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12.5" Foreground="{StaticResource InkBrush}" InputScope="Number" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <!-- Price Field with Placeholder -->
                                    <Grid Grid.Column="6">
                                        <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="8"/>
                                        <TextBlock Text="Price" Foreground="{StaticResource InkSoftBrush}" FontSize="12.5" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Price}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Price}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox helpers:NumericInput.Mode="DecimalOnly" Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12.5" Foreground="{StaticResource InkBrush}" InputScope="Number" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <!-- GST ComboBox -->
                                    <ComboBox Grid.Column="8" Style="{StaticResource RoundedComboBox}" Height="36" Padding="10,6" FontSize="12.5"
                                              ItemsSource="{Binding GstOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding GstPercent, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Total Read-only Field -->
                                    <Border Grid.Column="10" Background="#FBF5EE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                                        <TextBox Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12.5" IsReadOnly="True" Foreground="{StaticResource InkSoftBrush}" Text="{Binding TotalDisplay, Mode=OneWay}" VerticalContentAlignment="Center"/>
                                    </Border>

                                    <!-- Delete Row Button -->
                                    <Button Grid.Column="12" Content="&#10005;" Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource ErrorBrush}" Cursor="Hand" Click="RemoveItemButton_Click" ToolTip="Remove item row"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Row Button & Grand Total -->
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="+ Add Item" Style="{StaticResource OutlineButton}" Height="32" Padding="12,0" FontSize="12.5" Click="AddItemButton_Click"/>

                        <Border Grid.Column="2" Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="8" Padding="16,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Grand Total: " Foreground="{StaticResource InkSoftBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GrandTotalText" Text="₹0" Foreground="{StaticResource SaffronDeepBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,2,0,14"/>

                    <TextBlock Text="DELIVERY &amp; REFERENCE" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12"/>

                    <!-- Delivery Date & PO Ref Row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Expected Delivery (dd/mm/yyyy)" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DeliveryDatePicker" Language="en-IN" Style="{StaticResource RoundedDatePicker}"/>
                        </StackPanel>
                        <!-- <StackPanel Grid.Column="2">
                            <TextBlock Text="PO Reference" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#FBF5EE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10">
                                <TextBox x:Name="PoRefPreviewBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" IsReadOnly="True" Foreground="{StaticResource InkSoftBrush}" Text="Auto-generated on submit" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel> -->

                        <StackPanel Grid.Column="2">
                        <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="Enter optional remarks, terms, or notes..." Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,10" VerticalAlignment="Top" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=RemarksBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=RemarksBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="RemarksBox" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Height="45" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </StackPanel>
                    </Grid>

                    <!-- Remarks (optional) with Overlay Placeholder -->
                    <!-- <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="Enter optional remarks, terms, or notes..." Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,10" VerticalAlignment="Top" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=RemarksBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=RemarksBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="RemarksBox" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" Height="75" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </StackPanel> -->

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Height="36" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton" Content="Submit for Approval" Style="{StaticResource MiniButton}" Height="36" Padding="20,0" Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>