<Window x:Class="StockPortalApp.Views.FixedAssets.MapFixedAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Fixed Asset"
        Width="760" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Line -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon Badge -->
                    <Border Width="38" Height="38" CornerRadius="10" Background="#FFF5EC" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12zm-7-2h2v-4h4V8h-4V4h-2v4H9v2h4v4z"
                              Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="Map Fixed Asset" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Map one or more fixed assets to a room, each with its own unique code."
                                   FontSize="12" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Category Pill Badge -->
                    <Border Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Fixed Asset Mapping" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Close Button -->
                    <!-- <Button Content="✕" Style="{StaticResource OutlineButton}" Width="28" Height="28" Padding="0"
                            FontSize="12" Click="CancelButton_Click" Cursor="Hand" BorderThickness="0"/> -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Scroll Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="540">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Margin="22,16" Padding="24,20">
                <StackPanel>
                    <!-- LOCATION HEADER -->
                    <TextBlock Text="LOCATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}" Margin="0,0,0,10"/>

                    <!-- 1. Karyalya -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="1. Karyalya" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="KaryalyaCombo" Style="{StaticResource RoundedComboBox}" Tag="Select Karyalya"
                                  DisplayMemberPath="Name" SelectionChanged="KaryalyaCombo_SelectionChanged" Cursor="Hand"/>
                    </StackPanel>

                    <!-- 2. Department / Vibhag -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="2. Department / Vibhag" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DepartmentCombo" Style="{StaticResource RoundedComboBox}" Tag="Select Department / Vibhag"
                                  DisplayMemberPath="Name" SelectionChanged="DepartmentCombo_SelectionChanged" Cursor="Hand"/>
                    </StackPanel>

                    <!-- 3. Room No. -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="3. Room No. (optional)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="e.g. Room No. 46" Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=RoomNoBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=RoomNoBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="RoomNoBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,2,0,16"/>

                    <!-- ASSETS IN THIS ROOM -->
                    <TextBlock Text="ASSETS IN THIS ROOM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Add one row per physical item with its unique code (e.g. the asset tag or sticker number). Mapping Date defaults to today. Press Enter in a code box to add the next item of the same type."
                               FontSize="11.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- Header Labels for Rows -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FIXED ASSET ITEM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                        <TextBlock Grid.Column="2" Text="ITEM UNIQUE CODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                        <TextBlock Grid.Column="4" Text="MAPPING DATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                    </Grid>

                    <!-- Items Rows Container -->
                    <StackPanel x:Name="ItemsContainer" Margin="0,0,0,12"/>

                    <!-- + Add Item Button -->
                    <Button x:Name="AddItemButton" Click="AddItemButton_Click" Height="38" Cursor="Hand" Margin="0,0,0,16">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" BorderBrush="{StaticResource SaffronDeepBrush}" BorderThickness="1.5" CornerRadius="8" Background="#FFFBF7">
                                    <TextBlock Text="+ Add Item" Foreground="{StaticResource SaffronDeepBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFF2E5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Remarks (optional) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="Enter any additional remarks or notes..." Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,10" VerticalAlignment="Top" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=RemarksBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=RemarksBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="RemarksBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" Height="58" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Height="36" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton" Content="Map Asset" Style="{StaticResource MiniButton}" Height="36" Padding="22,0" Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
