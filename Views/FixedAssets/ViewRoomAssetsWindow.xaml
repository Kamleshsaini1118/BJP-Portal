<Window x:Class="StockPortalApp.Views.FixedAssets.ViewRoomAssetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Assets"
        Width="740" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Line -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon Badge -->
                    <Border Width="38" Height="38" CornerRadius="10" Background="#FFF5EC" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" 
                              Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RoomTitleText" Text="Room Assets" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock x:Name="RoomSubtitleText" Text="All physical fixed asset items mapped inside this room."
                                   FontSize="12" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tag Pill Badge -->
                    <Border Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Mapped Assets" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Close Button -->
                    <Button Content="✕" Style="{StaticResource OutlineButton}" Width="28" Height="28" Padding="0"
                            FontSize="12" Click="CloseButton_Click" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid Area -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Margin="22,16">
            <DataGrid x:Name="ItemsGrid" Style="{StaticResource AppDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ITEM NAME" Binding="{Binding ProductName}" Width="2*" ElementStyle="{StaticResource WrapTextCellStyle}"/>
                    <DataGridTextColumn Header="ITEM UNIQUE CODE" Binding="{Binding ItemUniqueCode}" Width="1.5*" FontWeight="SemiBold" ElementStyle="{StaticResource WrapTextCellStyle}"/>
                    <DataGridTextColumn Header="MAPPING DATE" Binding="{Binding MappingDateDisplay}" Width="1.2*" ElementStyle="{StaticResource WrapTextCellStyle}"/>
                    <DataGridTemplateColumn Header="STATUS" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="999" Padding="10,3" HorizontalAlignment="Left" Background="#DCFCE7">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11.5" Foreground="#15803D"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="36" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Border>
    </Grid>
</Window>
