<Window x:Class="StockPortalApp.Views.FixedAssets.AddKaryalyaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Karyalya"
        Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Accent Thread Line -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon Badge -->
                    <Border Width="38" Height="38" CornerRadius="10" Background="#FFF5EC" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-4-8h-2v2h2v-2zm0 4h-2v2h2v-2z" 
                              Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Add New Karyalya" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Register a karyalya so fixed assets can be mapped to it." FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tag Pill Badge -->
                    <Border Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Karyalya Master" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Close Button -->
                    <!-- <Button Content="✕" Style="{StaticResource OutlineButton}" Width="28" Height="28" Padding="0"
                            FontSize="12" Click="CancelButton_Click" Cursor="Hand" BorderThickness="0"/> -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Fields -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Margin="22,16" Padding="24,20">
            <StackPanel>
                <!-- Karyalya Name -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Karyalya Name "/>
                        <Run Text="*" Foreground="#DC2626"/>
                    </TextBlock>
                    <Grid>
                        <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                        <TextBlock Text="e.g. Jaipur Shahar Karyalya" Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=KaryalyaNameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=KaryalyaNameBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="KaryalyaNameBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Address -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Address "/>
                        <Run Text="*" Foreground="#DC2626"/>
                    </TextBlock>
                    <Grid>
                        <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                        <TextBlock Text="e.g. 12, Station Road, Jaipur, Rajasthan" Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,10" VerticalAlignment="Top" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="AddressBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" Height="64" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Grid>
                </StackPanel>

                <!-- Incharge Details (2 Columns) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="Incharge Name "/>
                            <Run Text="*" Foreground="#DC2626"/>
                        </TextBlock>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="e.g. Ramesh Kumar" Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=InchargeNameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=InchargeNameBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="InchargeNameBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="Incharge Contact "/>
                            <Run Text="*" Foreground="#DC2626"/>
                        </TextBlock>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="e.g. 98XXXXXXXX" Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=InchargeContactBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=InchargeContactBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="InchargeContactBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Height="36" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton" Content="Add Karyalya" Style="{StaticResource MiniButton}" Height="36" Padding="20,0" Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
