<Window x:Class="StockPortalApp.Views.FixedAssets.AssetHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asset History"
        Width="680"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Icon Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"
                              Fill="{StaticResource SaffronDeepBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HistoryHeaderTitle"
                                   Text="Asset History"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock x:Name="HistoryHeaderSubtitle"
                                   Text="Complete location and status history trail for this asset."
                                   FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1"
                        Background="#FFF5EC"
                        BorderBrush="#F0D5C0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="Activity Trail"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Compact Form Body Card -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="500">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="22,16"
                    Padding="22,20">
                <StackPanel>
                    <TextBlock Text="TIMELINE OF EVENTS"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="NoHistoryText"
                               Text="No history records found for this asset."
                               FontSize="13"
                               Foreground="{StaticResource InkSoftBrush}"
                               Visibility="Collapsed"
                               Margin="0,8,0,8"/>

                    <ItemsControl x:Name="HistoryItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Timeline node indicator -->
                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="#FFF5EC"
                                                BorderBrush="#F0D5C0"
                                                BorderThickness="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Top">
                                            <Path Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-1 14h2v2h-2v-2zm0-10h2v8h-2V6z"
                                                  Fill="{StaticResource SaffronDeepBrush}"
                                                  Stretch="Uniform"
                                                  Width="12"
                                                  Height="12"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Event Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding TitleDisplay}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13.5"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding RemarksDisplay}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasRemarks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- Date Badge -->
                                        <Border Grid.Column="2"
                                                Background="#F8FAFC"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding DateDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkSoftBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                        Style="{StaticResource MiniButton}"
                        Width="96"
                        Height="36"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
