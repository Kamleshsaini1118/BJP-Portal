<Window x:Class="StockPortalApp.Views.FixedAssets.MoveAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move Asset"
        Width="740"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Icon Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"
                              Fill="{StaticResource SaffronDeepBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Move Asset"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Relocate this fixed asset to a new Karyalya, Department or Room."
                                   FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1"
                        Background="#FFF5EC"
                        BorderBrush="#F0D5C0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="Relocate Asset"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Body Form Card -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="520">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="22,16"
                    Padding="22,20">
                <StackPanel>
                    <!-- SECTION 1: CURRENT ASSET DETAILS -->
                    <TextBlock Text="CURRENT ASSET DETAILS"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,12"/>

                    <Border Background="#FBF8F4"
                            BorderBrush="#EFE5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unique Code" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}"/>
                                <TextBlock x:Name="CurrentAssetCodeText"
                                           Text="PK-MV-CHR-001"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SaffronDeepBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Item Name" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}"/>
                                <TextBlock x:Name="CurrentAssetNameText"
                                           Text="Executive Chair"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Current Location" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}"/>
                                <TextBlock x:Name="CurrentAssetLocationText"
                                           Text="Pradesh Karyalya > Media Vibhag, Room 46"
                                           FontSize="12.5"
                                           Foreground="{StaticResource InkBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,16"/>

                    <!-- SECTION 2: TARGET LOCATION -->
                    <TextBlock Text="TARGET LOCATION"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Box 1: New Karyalya -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="1. New Karyalya" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TargetKaryalyaCombo"
                                      Style="{StaticResource RoundedComboBox}"
                                      Tag="Select Karyalya"
                                      Height="38"
                                      SelectionChanged="TargetKaryalyaCombo_SelectionChanged"
                                      Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Id}" Value="-999">
                                                            <Setter Property="Foreground" Value="{StaticResource SaffronDeepBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Box 2: New Department -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="2. New Department / Vibhag" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TargetDepartmentCombo"
                                      Style="{StaticResource RoundedComboBox}"
                                      Tag="Select Karyalya first"
                                      Height="38"
                                      SelectionChanged="TargetDepartmentCombo_SelectionChanged"
                                      Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Id}" Value="-999">
                                                            <Setter Property="Foreground" Value="{StaticResource SaffronDeepBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Box 3: New Room No. -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="3. New Room No. (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TargetRoomNoBox"
                                     Style="{StaticResource RoundedTextBox}"
                                     Tag="e.g. Room No. 48"
                                     Height="38"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,16"/>

                    <!-- SECTION 3: MOVE DETAILS -->
                    <TextBlock Text="MOVE DETAILS"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Move Date -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Move Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="MoveDatePicker"
                                        Style="{StaticResource RoundedDatePicker}"
                                        Height="38"/>
                        </StackPanel>

                        <!-- Remarks -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MoveRemarksBox"
                                     Style="{StaticResource RoundedTextBox}"
                                     Tag="e.g. Relocated during office renovation"
                                     Height="38"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        Width="90"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveMoveButton"
                        Content="Save Move"
                        Style="{StaticResource MiniButton}"
                        Height="36"
                        Padding="24,0"
                        Click="SaveMoveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
