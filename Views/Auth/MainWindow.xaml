<Window x:Class="StockPortalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Portal — Sign In"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Top-right window controls (always visible, regardless of OS title bar) -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Panel.ZIndex="10">
            <!--<Button x:Name="MinimizeButton" Width="32" Height="32" Margin="0,0,8,0"
                    Click="MinimizeButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Background="#12000000">
                            <TextBlock Text="&#8212;" FontSize="14" Foreground="{StaticResource InkSoftBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CloseButton" Width="32" Height="32"
                    Click="CloseButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Background="#12000000">
                            <TextBlock x:Name="CloseIcon" Text="&#10005;" FontSize="13" Foreground="{StaticResource InkSoftBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ErrorBrush}"/>
                                <Setter TargetName="CloseIcon" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>-->
        </StackPanel>

        <!-- ============ LEFT: IDENTITY PANEL ============ -->
        <Border Grid.Column="0"
                Background="{StaticResource IdentityGradient}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- .thread : 3-colour stripe across the top -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0"
                               Fill="#FF9933"/>
                    <Rectangle Grid.Column="1"
                               Fill="White"/>
                    <Rectangle Grid.Column="2"
                               Fill="#138808"/>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="64,44,64,56">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- .brand-row -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Border Width="46"
                                Height="46"
                                CornerRadius="10"
                                Background="#26FFFFFF"
                                BorderBrush="#59FFFFFF"
                                BorderThickness="1">
                            <Grid Width="24"
                                  Height="24">
                                <Ellipse Stroke="White"
                                         StrokeThickness="1.4"/>
                                <Line X1="12"
                                      Y1="2"
                                      X2="12"
                                      Y2="22"
                                      Stroke="White"
                                      StrokeThickness="0.8"
                                      Opacity="0.5"/>
                                <Line X1="2"
                                      Y1="12"
                                      X2="22"
                                      Y2="12"
                                      Stroke="White"
                                      StrokeThickness="0.8"
                                      Opacity="0.5"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="14,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Stock Portal"
                                       Foreground="White"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontWeight="Bold"
                                       FontSize="19"/>
                            <TextBlock Text="B H A R A T I Y A   J A N A T A   P A R T Y"
                                       Foreground="White"
                                       Opacity="0.85"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- .signature-wrap : chakra watermark + lotus -->
                    <Grid Grid.Row="1">
                        <Viewbox x:Name="ChakraViewbox"
                                 Width="460"
                                 Height="460"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Opacity="0.09"
                                 RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="ChakraRotate"
                                                 Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Canvas x:Name="ChakraCanvas"
                                    Width="200"
                                    Height="200">
                                <Ellipse Canvas.Left="10"
                                         Canvas.Top="10"
                                         Width="180"
                                         Height="180"
                                         Stroke="White"
                                         StrokeThickness="1"/>
                                <Ellipse Canvas.Left="30"
                                         Canvas.Top="30"
                                         Width="140"
                                         Height="140"
                                         Stroke="White"
                                         StrokeThickness="1"/>
                                <!-- 24 spokes are added at runtime in MainWindow.xaml.cs -->
                            </Canvas>
                        </Viewbox>

                        <Viewbox Width="300"
                                 Height="300"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Viewbox.Effect>
                                <DropShadowEffect Color="#782800"
                                                  Opacity="0.28"
                                                  BlurRadius="30"
                                                  ShadowDepth="10"
                                                  Direction="270"/>
                            </Viewbox.Effect>
                            <Canvas Width="340"
                                    Height="340">
                                <Path x:Name="Petal1"
                                      Data="M170 210 C120 190 90 150 100 100 C150 110 175 150 170 210Z"
                                      Fill="#FFFFFF"
                                      Opacity="0.95">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="Scale1"
                                                        CenterX="170"
                                                        CenterY="210"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Petal2"
                                      Data="M170 210 C220 190 250 150 240 100 C190 110 165 150 170 210Z"
                                      Fill="#FFFFFF"
                                      Opacity="0.95">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="Scale2"
                                                        CenterX="170"
                                                        CenterY="210"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Petal3"
                                      Data="M170 210 C135 175 120 130 145 85 C185 105 195 155 170 210Z"
                                      Fill="#FFF3E4"
                                      Opacity="0.97">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="Scale3"
                                                        CenterX="170"
                                                        CenterY="210"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Petal4"
                                      Data="M170 210 C205 175 220 130 195 85 C155 105 145 155 170 210Z"
                                      Fill="#FFF3E4"
                                      Opacity="0.97">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="Scale4"
                                                        CenterX="170"
                                                        CenterY="210"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Petal5"
                                      Data="M170 210 C150 180 148 145 170 110 C192 145 190 180 170 210Z"
                                      Fill="#FFFFFF">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="Scale5"
                                                        CenterX="170"
                                                        CenterY="210"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Petal6"
                                      Data="M170 210 C155 190 155 165 170 140 C185 165 185 190 170 210Z"
                                      Fill="#FFE3BF">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="Scale6"
                                                        CenterX="170"
                                                        CenterY="210"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Petal7"
                                      Data="M136 215 A34,12 0 1 0 204,215 A34,12 0 1 0 136,215 Z"
                                      Fill="#0C6606"
                                      Opacity="0.85">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="Scale7"
                                                        CenterX="170"
                                                        CenterY="215"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <!-- .mission-copy -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Foreground="White"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="30"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   Margin="0,0,0,10"
                                   LineHeight="38">
                            <Run Text="Ek Bharat, Shreshtha Bharat."/>
                            <LineBreak/>
                            <Run Text="Serve. Organize. Lead."/>
                        </TextBlock>
                        <TextBlock Foreground="White"
                                   Opacity="0.92"
                                   FontSize="14.5"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"
                                   LineHeight="22"
                                   Text="Sign in to coordinate booth-level activity, track membership drives, and stay aligned with the party's outreach calendar — all in one place."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ RIGHT: FORM PANEL ============ -->
        <Border Grid.Column="1"
                Background="{StaticResource PaperBrush}">
            <Grid>
                <StackPanel MaxWidth="400"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="M E M B E R   S I G N   I N"
                               Foreground="{StaticResource SaffronDeepBrush}"
                               FontWeight="Bold"
                               FontSize="12"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Welcome back"
                               Foreground="{StaticResource InkBrush}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="Bold"
                               FontSize="27"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Enter your membership credentials to access the portal."
                               Foreground="{StaticResource InkSoftBrush}"
                               FontSize="14"
                               Margin="0,0,0,30"
                               TextWrapping="Wrap"/>

                    <!-- Membership ID field -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Membership ID or Mobile Number"
                                   Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="MemberIdTextBox"
                                     Style="{StaticResource RoundedTextBox}"
                                     Height="48"
                                     Padding="16,0,14,0"
                                     VerticalContentAlignment="Center"/>

                            <!-- User Profile Icon (Left) -->
                            <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                  Fill="#9E8E80"
                                  Width="15"
                                    Height="15"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  Margin="14,0,0,0"
                                  IsHitTestVisible="False"/>

                            <!-- Auto-Hiding Placeholder -->
                            <TextBlock Text="e.g. BJP-2024-XXXXXX or 98XXXXXXXX"
                                       Visibility="{Binding Text, ElementName=MemberIdTextBox, Converter={StaticResource StringToVisibilityConverter}}"
                                       Foreground="#B9AA9B"
                                       FontSize="14.5"
                                       Margin="38,0,14,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- Password field -->
                     <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Password"
                                   Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <PasswordBox x:Name="PasswordBoxInput"
                                         Style="{StaticResource RoundedPasswordBox}"
                                         Height="48"
                                         Padding="16,0,14,0"
                                         VerticalContentAlignment="Center"
                                         PasswordChanged="PasswordBoxInput_PasswordChanged"/>

                            <TextBox x:Name="PasswordTextBoxInput"
                                     Style="{StaticResource RoundedTextBox}"
                                     Height="48"
                                     Padding="16,0,44,0"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed"
                                     TextChanged="PasswordTextBoxInput_TextChanged"/>

                            <!-- Security Lock Icon (Left) -->
                            <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                  Fill="#9E8E80"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  Margin="14,0,0,0"
                                  IsHitTestVisible="False"/>

                            <!-- Password Placeholder -->
                            <TextBlock x:Name="PasswordPlaceholder"
                                       Text="Enter your password"
                                       Foreground="#B9AA9B"
                                       FontSize="14.5"
                                       Margin="38,0,14,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <!-- Eye Show/Hide Toggle Button (Right) -->
                            <Button x:Name="TogglePasswordVisibilityButton"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    Click="TogglePasswordVisibilityButton_Click"
                                    ToolTip="Show/Hide password">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="16">
                                            <Grid>
                                                <!-- Eye Open Icon (hidden mode) -->
                                                <Path x:Name="EyeOpenIcon"
                                                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                                      Fill="#9E8E80"
                                                      Width="16" Height="16"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                <!-- Eye Closed Icon (plain text mode) -->
                                                <Path x:Name="EyeClosedIcon"
                                                      Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z"
                                                      Fill="{StaticResource SaffronDeepBrush}"
                                                      Width="16" Height="16"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Remember + forgot -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="RememberMeCheckBox"
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Content="Keep me signed in"
                                  Foreground="{StaticResource InkSoftBrush}"
                                  FontSize="13"/>
                        <Button x:Name="ForgotPasswordButton"
                                Grid.Column="1"
                                Content="Forgot password?"
                                Style="{StaticResource LinkButton}"
                                Click="ForgotPasswordButton_Click"/>
                    </Grid>

                    <!-- Error message -->
                    <TextBlock x:Name="LoginErrorText"
                               Text="Invalid credentials. Try again."
                               Foreground="{StaticResource ErrorBrush}"
                               FontWeight="Bold"
                               FontSize="13"
                               Margin="0,0,0,14"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"/>

                    <Button x:Name="SignInButton"
                            Content="Sign In"
                            Style="{StaticResource PrimaryButton}"
                            Click="SignInButton_Click"
                            Height="46"/>

                    <TextBlock Foreground="#B9AA9B"
                               FontSize="11.5"
                               TextAlignment="Center"
                               Margin="0,40,0,0"
                               TextWrapping="Wrap"
                               LineHeight="17">
                        By signing in you agree to the Portal's Code of Conduct and Data Privacy Guidelines.
                        <LineBreak/>
                        Trouble accessing your account? Contact your district IT coordinator.
                    </TextBlock>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
