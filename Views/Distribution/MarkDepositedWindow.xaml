<Window x:Class="StockPortalApp.MarkDepositedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StockPortalApp.Helpers"
        Title="Mark Items Deposited"
        Width="720" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Deposit Return Icon Badge -->
                    <Border Width="38" Height="38" CornerRadius="9" Background="#E8F5E4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                              Fill="#0C6606" Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="Mark Items Deposited" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Enter how many units were actually returned for each item. If less than issued, add a reason." FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1" Background="#E8F5E4" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="Deposit Return" FontSize="11" FontWeight="Bold" Foreground="#0C6606"/>
                </Border>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer x:Name="BodyScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="22,16" Padding="22,20">
                <StackPanel>

                    <!-- Section 1: Receiver Details -->
                    <TextBlock Text="RECEIVER DETAILS" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Receiver Name -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Receiver Name" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                <TextBox x:Name="ReceiverNameBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Receiver Number -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Receiver Number" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                <TextBox x:Name="ReceiverNumberBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Receiver Position -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Receiver Position" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                <TextBox x:Name="ReceiverPositionBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,2,0,16"/>

                    <!-- Section 2: Items Deposit List -->
                    <TextBlock Text="RETURNED ITEMS" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12"/>

                    <ItemsControl x:Name="ItemRowsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- Header Row: Item Name & Issued Badge -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding ProductName, Mode=OneWay}" 
                                                       FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>

                                            <Border Grid.Column="1" Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="{Binding IssuedLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SaffronDeepBrush}"/>
                                            </Border>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="1.6*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Deposited Count -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Deposited Count" Style="{StaticResource FieldLabel}"/>
                                                <Grid>
                                                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                                    <TextBox helpers:NumericInput.Mode="DigitsOnly" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" InputScope="Number" VerticalContentAlignment="Center"
                                                             Text="{Binding DepositedCount, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Reason for Shortfall -->
                                            <StackPanel Grid.Column="2" Visibility="{Binding ShortfallReasonVisibility}">
                                                <TextBlock Text="Reason for Shortfall" Style="{StaticResource FieldLabel}"/>
                                                <Grid>
                                                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                                    <TextBlock Text="Reason if returned count is less than issued" Foreground="{StaticResource InkSoftBrush}" FontSize="12.5" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=Grid}, Path=Children[1].Text}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=Grid}, Path=Children[1].Text}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"
                                                             Text="{Binding ShortfallReason, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Height="36" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton" Content="Save Deposits" Style="{StaticResource MiniButton}" Height="36" Padding="24,0" Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>