<Window x:Class="StockPortalApp.AssetDistributionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Distribution Detail"
        Width="750"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Stripe Line -->
        <Grid Grid.Row="0"
              Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0"
                       Fill="#FF9933"/>
            <Rectangle Grid.Column="1"
                       Fill="White"/>
            <Rectangle Grid.Column="2"
                       Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Distribution Truck Icon Badge -->
                    <Border Width="36"
                            Height="36"
                            CornerRadius="8"
                            Background="#FFF5EC"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Path Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                              Fill="{StaticResource SaffronDeepBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle"
                                   Text="Distribution Detail"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Every shipment this item has gone out in."
                                   FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1"
                        Background="#FFF5EC"
                        BorderBrush="#F0D5C0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="Asset History"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Area -->
        <Grid Grid.Row="2"
              Margin="24,20">
            <!-- Empty State Card -->
            <Border x:Name="EmptyText"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="36,40"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="#FFF8F0"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Path Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"
                              Fill="{StaticResource InkSoftBrush}"
                              Stretch="Uniform"
                              Width="22"
                              Height="22"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0.5"/>
                    </Border>
                    <TextBlock Text="No Distribution Records"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="There are no distribution or shipment records logged for this item yet."
                               Foreground="{StaticResource InkSoftBrush}"
                               FontSize="12.5"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Table Container Card -->
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">

                <DataGrid x:Name="DetailGrid"
                          Style="{StaticResource AppDataGrid}"
                          MaxHeight="400"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <!-- <DataGrid.Columns>
                        <DataGridTextColumn Header="Distributed To"
                                            Binding="{Binding Destination}"
                                            Width="1.4*"/>

                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding QtyDisplay}"
                                            Width="0.8*"/>

                        <DataGridTextColumn Header="Receiver Name"
                                            Binding="{Binding ReceiverNameDisplay}"
                                            Width="1.3*"/>

                        <DataGridTextColumn Header="Receiver Number"
                                            Binding="{Binding ReceiverNumberDisplay}"
                                            Width="1.3*"/>

                        <DataGridTextColumn Header="Position"
                                            Binding="{Binding PositionDisplay}"
                                            Width="0.9*"/>

                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding DateDisplay}"
                                            Width="1.5*"/>
                    </DataGrid.Columns> -->

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Distributed To"
                                            Binding="{Binding Destination}"
                                            Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding QtyDisplay}"
                                            Width="0.8*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Receiver Name"
                                            Binding="{Binding ReceiverNameDisplay}"
                                            Width="1.3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Receiver Number"
                                            Binding="{Binding ReceiverNumberDisplay}"
                                            Width="1.3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Position"
                                            Binding="{Binding PositionDisplay}"
                                            Width="0.9*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding DateDisplay}"
                                            Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Close"
                        Style="{StaticResource OutlineButton}"
                        Width="90"
                        Height="36"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>