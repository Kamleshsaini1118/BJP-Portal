<Window x:Class="StockPortalApp.AddEditReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utility Reminder"
        Width="580"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Window.Resources>
        <!-- Pill CheckBox Style for Remind Me Before -->
        <Style x:Key="PillCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,8,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="PillBorder"
                                Background="White"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.5"
                                CornerRadius="18"
                                Padding="14,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CheckSquare"
                                        Width="16" Height="16"
                                        CornerRadius="4"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1.5"
                                        Background="White"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckIcon"
                                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                          Fill="{StaticResource SaffronDeepBrush}"
                                          Stretch="Uniform"
                                          Width="10" Height="10"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#FFF5EC"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource SaffronDeepBrush}"/>
                                <Setter TargetName="CheckSquare" Property="BorderBrush" Value="{StaticResource SaffronDeepBrush}"/>
                                <Setter TargetName="CheckSquare" Property="Background" Value="#FFF5EC"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource SaffronDeepBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource SaffronDeepBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Accent Line -->
            <RowDefinition Height="Auto"/> <!-- Header Bar -->
            <RowDefinition Height="*"/>    <!-- Form Card Body -->
            <RowDefinition Height="Auto"/> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Header Bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Bell / Reminder Icon Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                              Fill="{StaticResource SaffronDeepBrush}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderText"
                                   Text="Create Reminder"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18.5"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Get reminded ahead of a utility bill or payment's due date."
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Side Tag Badge & Active Close Button -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#FFF5EC"
                            BorderBrush="#F0D5C0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Utility Reminder"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Active Close Button -->
                    <!-- <Button Click="CancelButton_Click"
                            Cursor="Hand"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="6">
                                    <TextBlock Text="✕"
                                               FontSize="15"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#12000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button> -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="520">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="22,18"
                    Padding="24,20">
                <StackPanel>

                    <!-- Utility Selection -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Utility" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="UtilityCombo"
                                  MinHeight="40"
                                  Padding="12,0"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource SearchableComboBox}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Due Date (Day of Month) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Due Date (Day of Month)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DueDayCombo"
                                  MinHeight="40"
                                  Padding="12,0"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource SearchableComboBox}" Cursor="Hand"/>
                        <TextBlock Text="This bill is due on this day every month — the reminder repeats monthly, it isn't a one-time date."
                                   FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- REMIND ME BEFORE (Multi-select Pill Checkboxes) -->
                    <StackPanel Margin="0,16,0,14">
                        <TextBlock Text="REMIND ME BEFORE"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,10"/>

                        <WrapPanel x:Name="RemindBeforeWrapPanel">
                            <CheckBox x:Name="ChkN1" Content="N-1" Style="{StaticResource PillCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkN2" Content="N-2" Style="{StaticResource PillCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkN3" Content="N-3" Style="{StaticResource PillCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkN5" Content="N-5" Style="{StaticResource PillCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkN7" Content="N-7" Style="{StaticResource PillCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkN10" Content="N-10" Style="{StaticResource PillCheckBoxStyle}"/>
                            <CheckBox x:Name="ChkN15" Content="N-15" Style="{StaticResource PillCheckBoxStyle}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Remarks (optional) -->
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RemarksBox"
                                 MinHeight="68"
                                 Padding="12,8"
                                 FontSize="13.5"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Tag="Any notes for this reminder..."
                                 Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        Padding="22,9"
                        Height="38"
                        FontSize="13"
                        Margin="0,0,12,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SubmitButton"
                        Content="Submit"
                        Style="{StaticResource PrimaryButton}"
                        Padding="36,9"
                        Height="38"
                        FontSize="13"
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>