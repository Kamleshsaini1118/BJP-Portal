<UserControl x:Class="StockPortalApp.Views.Reports.QuotationComparisonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100">
    <StackPanel>
        <!-- FILTER CARD -->
        <Border Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,0,0,20">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- PROJECT CATEGORY -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="PROJECT CATEGORY" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CategoryFilterCombo" Width="200" Height="36" Style="{StaticResource RoundedComboBox}" SelectedIndex="0" Cursor="Hand"/>
                </StackPanel>

                <!-- PROJECT STATUS -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="PROJECT STATUS" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="StatusFilterCombo" Width="180" Height="36" Style="{StaticResource RoundedComboBox}" SelectedIndex="0" Cursor="Hand">
                        <ComboBoxItem Content="Any status"/>
                        <ComboBoxItem Content="Open"/>
                        <ComboBoxItem Content="Finalized"/>
                        <ComboBoxItem Content="Cancelled"/>
                    </ComboBox>
                </StackPanel>

                <!-- ACTION BUTTONS -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Clear Filters"
                            Style="{StaticResource OutlineButton}"
                            Height="36"
                            Padding="14,0"
                            Margin="0,0,10,0"
                            Click="ClearFiltersButton_Click"/>
                    <Button Content="Apply Filters"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Padding="18,0"
                            Click="ApplyFiltersButton_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- REPORT HEADER & SUMMARY BAR -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Quotation Comparison Report"
                       FontFamily="{StaticResource HeadingFont}"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="{StaticResource InkBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Summary Pill Badge -->
                <Border Background="#FFF5EC"
                        BorderBrush="#FCE4D6"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryBadgeText"
                               Text="0 quotations"
                               FontWeight="Bold"
                               FontSize="12.5"
                               Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>

                <!-- Export to Excel Button -->
                <Button Content="Export to Excel"
                        Style="{StaticResource OutlineButton}"
                        Height="36"
                        Padding="14,0"
                        Click="ExportExcelButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- DATAGRID -->
        <Border Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0">
            <Grid>
                <DataGrid x:Name="QuotationGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource LineBrush}"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="42"
                          ColumnHeaderHeight="40"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FAFAF8"/>
                            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="BorderBrush" Value="{StaticResource SaffronDeepBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFFBF7"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFFBF7"/>
                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectTitle}" Width="*"/>
                        <DataGridTextColumn Header="VENDOR" Binding="{Binding VendorName}" Width="200"/>
                        <DataGridTextColumn Header="QUOTATION NUMBER" Binding="{Binding QuotationNumber}" Width="160"/>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountDisplay}" Width="140" ElementStyle="{StaticResource BoldCellText}"/>
                        <DataGridTextColumn Header="QUOTATION STATUS" Binding="{Binding QuotationStatus}" Width="150"/>
                        
                        <!-- L1 (LOWEST) Pill Badge -->
                        <DataGridTemplateColumn Header="L1 (LOWEST)" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Border Visibility="{Binding IsL1, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#EBFbee"
                                                BorderBrush="#D3F9D8"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="L1" Foreground="#2B8A3E" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="—" Visibility="{Binding IsNotL1, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource InkSoftBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="PROJECT STATUS" Binding="{Binding ProjectStatus}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyGridText"
                           Text="No quotation records found."
                           Foreground="{StaticResource InkSoftBrush}"
                           FontSize="13.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,50"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
