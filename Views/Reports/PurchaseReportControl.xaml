<UserControl x:Class="StockPortalApp.Views.Reports.PurchaseReportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100">
    <StackPanel>
        <!-- FILTER CARD -->
        <Border Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,0,0,20">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- VENDOR -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="VENDOR" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="VendorFilterCombo" Width="160" Height="38" Style="{StaticResource RoundedComboBox}" SelectedIndex="0" Cursor="Hand"/>
                </StackPanel>

                <!-- RECEIVED AGAINST -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="RECEIVED AGAINST" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ReceivedAgainstCombo" Width="140" Height="38" Style="{StaticResource RoundedComboBox}" SelectedIndex="0" Cursor="Hand">
                        <ComboBoxItem Content="Any"/>
                        <ComboBoxItem Content="PO"/>
                        <ComboBoxItem Content="Direct"/>
                    </ComboBox>
                </StackPanel>

                <!-- PAYMENT MODE -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="PAYMENT MODE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PaymentModeCombo" Width="140" Height="38" Style="{StaticResource RoundedComboBox}" SelectedIndex="0" Cursor="Hand">
                        <ComboBoxItem Content="Any mode"/>
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Cheque"/>
                        <ComboBoxItem Content="UPI"/>
                        <ComboBoxItem Content="Bank Transfer"/>
                    </ComboBox>
                </StackPanel>

                <!-- FROM DATE -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="FROM DATE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="FromDatePicker" Width="145" Height="38" Language="en-IN" Style="{StaticResource RoundedDatePicker}" Cursor="Hand"/>
                </StackPanel>

                <!-- TO DATE -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="TO DATE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="ToDatePicker" Width="145" Height="38" Language="en-IN" Style="{StaticResource RoundedDatePicker}" Cursor="Hand"/>
                </StackPanel>

                <!-- MIN AMOUNT -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="MIN AMOUNT" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MinAmountBox" Width="110" Height="38" Tag="e.g. 0" Style="{StaticResource RoundedTextBox}"/>
                </StackPanel>

                <!-- MAX AMOUNT -->
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="MAX AMOUNT" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MaxAmountBox" Width="110" Height="38" Tag="e.g. 500000" Style="{StaticResource RoundedTextBox}"/>
                </StackPanel>

                <!-- ACTION BUTTONS -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Clear Filters"
                            Style="{StaticResource OutlineButton}"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,10,0"
                            Click="ClearFiltersButton_Click"/>
                    <Button Content="Apply Filters"
                            Style="{StaticResource PrimaryButton}"
                            Height="38"
                            Padding="18,0"
                            Click="ApplyFiltersButton_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- REPORT HEADER & SUMMARY BAR -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Purchase Report"
                       FontFamily="{StaticResource HeadingFont}"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="{StaticResource InkBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Summary Pill Badge -->
                <Border Background="#FFF5EC"
                        BorderBrush="#FCE4D6"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryBadgeText"
                               Text="0 purchases · Total: ₹0"
                               FontWeight="Bold"
                               FontSize="12.5"
                               Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>

                <!-- Export to Excel Button -->
                <Button Content="Export to Excel"
                        Style="{StaticResource OutlineButton}"
                        Height="36"
                        Padding="14,0"
                        Click="ExportExcelButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- DATAGRID -->
        <Border Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0">
            <Grid>
                <DataGrid x:Name="PurchaseGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource LineBrush}"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="42"
                          ColumnHeaderHeight="40"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FAFAF8"/>
                            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="BorderBrush" Value="{StaticResource SaffronDeepBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFFBF7"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFFBF7"/>
                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding PurchaseDate, StringFormat='dd MMM yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="PO REFERENCE" Binding="{Binding PoReferenceDisplay}" Width="150"/>
                        <DataGridTextColumn Header="INVOICE / CHALLAN" Binding="{Binding InvoiceOrChallanDisplay}" Width="190"/>
                        <DataGridTextColumn Header="VENDOR" Binding="{Binding VendorName}" Width="*"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding PurchaseType}" Width="110"/>
                        <DataGridTextColumn Header="PAYMENT MODE" Binding="{Binding PaymentModeDisplay}" Width="140"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalDisplay}" Width="130" ElementStyle="{StaticResource BoldCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyGridText"
                           Text="No purchase records found matching filters."
                           Foreground="{StaticResource InkSoftBrush}"
                           FontSize="13.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,50"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
