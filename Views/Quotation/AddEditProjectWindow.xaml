<Window x:Class="StockPortalApp.AddEditProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StockPortalApp.Helpers"
        Title="Project"
        Width="620"
        SizeToContent="Height"
        MaxHeight="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Accent Line -->
            <RowDefinition Height="Auto"/> <!-- Header Bar -->
            <RowDefinition Height="*"/>    <!-- Form Card Body -->
            <RowDefinition Height="Auto"/> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Header Bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Project Folder Icon Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z"
                              Stroke="{StaticResource SaffronDeepBrush}"
                              StrokeThickness="1.8"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderText"
                                   Text="Create Project"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18.5"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Set up a project to collect and compare vendor quotations against."
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Side Tag Badge & Active Close Button -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#FFF5EC"
                            BorderBrush="#F0D5C0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Quotation Project"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Active Close Button -->
                    <!-- <Button Click="CancelButton_Click"
                            Cursor="Hand"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="6">
                                    <TextBlock Text="✕"
                                               FontSize="15"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#12000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button> -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="540">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="22,18"
                    Padding="24,20">
                <StackPanel>

                    <TextBlock Text="PROJECT DETAILS"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,14"/>

                    <!-- Project Name -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Project Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ProjectNameBox"
                                 MinHeight="40"
                                 Padding="12,0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Tag="e.g. District Office Renovation"
                                 Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>

                    <!-- Row 1: Client/Department & Category -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Client / Department" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ClientDepartmentBox"
                                     MinHeight="40"
                                     Padding="12,0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Tag="e.g. Alwar District Unit"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryCombo"
                                      MinHeight="40"
                                      Padding="12,0"
                                      FontSize="14"
                                      VerticalContentAlignment="Center"
                                      Style="{StaticResource SearchableComboBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Estimated Budget & Start Date -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Estimated Budget (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BudgetBox"
                                     helpers:NumericInput.Mode="DecimalOnly"
                                     InputScope="Number"
                                     MinHeight="40"
                                     Padding="12,0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Tag="e.g. 500000"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Start Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="StartDatePicker"
                                        MinHeight="40"
                                        Padding="10,0"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Language="en-IN"
                                        Style="{StaticResource RoundedDatePicker}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Project Status -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Project Status" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StatusCombo"
                                  MinHeight="40"
                                  Padding="12,0"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource SearchableComboBox}"/>
                    </StackPanel>

                    <!-- Remarks -->
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RemarksBox"
                                 MinHeight="68"
                                 Padding="12,8"
                                 FontSize="13.5"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Tag="Any notes about this project..."
                                 Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        Padding="22,9"
                        Height="38"
                        FontSize="13"
                        Margin="0,0,12,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SubmitButton"
                        Content="Submit"
                        Style="{StaticResource PrimaryButton}"
                        Padding="40,9"
                        Height="38"
                        FontSize="13"
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
