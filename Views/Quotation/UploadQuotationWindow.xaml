<Window x:Class="StockPortalApp.UploadQuotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StockPortalApp.Helpers"
        Title="Upload Quotation"
        Width="620"
        SizeToContent="Height"
        MaxHeight="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Accent Line -->
            <RowDefinition Height="Auto"/> <!-- Header Bar -->
            <RowDefinition Height="*"/>    <!-- Form Card Body -->
            <RowDefinition Height="Auto"/> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Header Bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Upload File Icon Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2Z"
                              Stroke="{StaticResource SaffronDeepBrush}"
                              StrokeThickness="1.8"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderText"
                                   Text="Upload Quotation"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18.5"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Attach a vendor's quotation to a project so it can be compared/tracked."
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Side Tag Badge & Active Close Button -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#FFF5EC"
                            BorderBrush="#F0D5C0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Vendor Quote"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Active Close Button -->
                    <!-- <Button Click="CancelButton_Click"
                            Cursor="Hand"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="6">
                                    <TextBlock Text="✕"
                                               FontSize="15"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#12000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button> -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="540">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="22,18"
                    Padding="24,20">
                <StackPanel>

                    <TextBlock Text="QUOTATION DETAILS"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkSoftBrush}"
                               Margin="0,0,0,14"/>

                    <!-- Project Selection -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Project" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ProjectCombo"
                                  MinHeight="40"
                                  Padding="12,0"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="ProjectName"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource SearchableComboBox}"/>
                    </StackPanel>

                    <!-- Row 1: Vendor Name & Quotation Number -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vendor Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="VendorNameBox"
                                     MinHeight="40"
                                     Padding="8,0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Tag="e.g. Shree Balaji Construction"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quotation Number (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="QuotationNumberBox"
                                     MinHeight="40"
                                     Padding="8,0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Tag="e.g. QT-2026-101"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Quotation Amount & Status -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quotation Amount" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AmountBox"
                                     helpers:NumericInput.Mode="DecimalOnly"
                                     InputScope="Number"
                                     MinHeight="48"
                                     Padding="16,0,14,0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Tag="e.g. 780000"
                                     Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="StatusCombo"
                                      MinHeight="48"
                                      Padding="16,0,14,0"
                                      FontSize="14"
                                      VerticalContentAlignment="Center"
                                      Style="{StaticResource SearchableComboBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Quotation Date & Valid Until -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quotation Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="QuotationDatePicker"
                                        MinHeight="40"
                                        Padding="10,0"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Language="en-IN"
                                        Style="{StaticResource RoundedDatePicker}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valid Until (optional)" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="ValidUntilPicker"
                                        MinHeight="40"
                                        Padding="10,0"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Language="en-IN"
                                        Style="{StaticResource RoundedDatePicker}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Remarks -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RemarksBox"
                                 MinHeight="60"
                                 Padding="16,0,14,0"
                                 FontSize="13.5"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Tag="Any notes about this quotation..."
                                 Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>

                    <!-- File Upload Dropzone Box -->
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="QUOTATION FILE (OPTIONAL)"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,0,0,8"/>
                        <Border x:Name="FileDropZone"
                                Background="#FFFBF7"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="20,16"
                                Cursor="Hand"
                                MouseDown="FileDropZone_MouseDown">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="FileNameText"
                                           Text="Click to upload the quotation — image or PDF, multiple allowed"
                                           FontSize="12.5"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        Padding="22,9"
                        Height="38"
                        FontSize="13"
                        Margin="0,0,12,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SubmitButton"
                        Content="Submit"
                        Style="{StaticResource PrimaryButton}"
                        Padding="40,9"
                        Height="38"
                        FontSize="13"
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
