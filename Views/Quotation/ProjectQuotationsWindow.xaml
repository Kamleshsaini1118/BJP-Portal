<Window x:Class="StockPortalApp.ProjectQuotationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Quotations"
        Width="720"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Accent Line -->
            <RowDefinition Height="Auto"/> <!-- Header Bar -->
            <RowDefinition Height="*"/>    <!-- Scrollable Content Body -->
            <RowDefinition Height="Auto"/> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Header Bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Project Quotations Icon Badge -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="#FFF5EC"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Path Data="M9 12 H15 M9 16 H15 M9 8 H10 M6 3 H15 L20 8 V21 A1,1 0 0 1 19,22 H6 A1,1 0 0 1 5,21 V4 A1,1 0 0 1 6,3 Z"
                              Stroke="{StaticResource SaffronDeepBrush}"
                              StrokeThickness="1.8"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProjectHeaderTitle"
                                   Text="District Office Renovation — Quotations"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                   FontSize="18.5"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Compare the vendor quotations received for this project."
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Side Tag Badge & SINGLE Close Button -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#FFF5EC"
                            BorderBrush="#F0D5C0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Quotations Comparison"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SaffronDeepBrush}"/>
                    </Border>

                    <!-- Single Clean Close Button -->
                    <!-- <Button Click="CloseButton_Click"
                            Cursor="Hand"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="6">
                                    <TextBlock Text="✕"
                                               FontSize="15"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#12000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button> -->


                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="540">
            <StackPanel Margin="22,18">

                <!-- Project Summary Card -->
                <Border Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16"
                        Margin="0,0,0,20">
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock Text="Client / Department" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                            <TextBlock x:Name="SumClientText" Text="Alwar District Unit" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Category" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                            <TextBlock x:Name="SumCategoryText" Text="Construction" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Estimated Budget" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                            <TextBlock x:Name="SumBudgetText" Text="₹8,50,000" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Status" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"/>
                            <TextBlock x:Name="SumStatusText" Text="Open" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource SaffronDeepBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Section Title -->
                <TextBlock Text="QUOTATIONS RECEIVED"
                           FontSize="11.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource InkSoftBrush}"
                           Margin="0,0,0,14"/>

                <!-- Empty State Message -->
                <TextBlock x:Name="EmptyQuotationsText"
                           Text="No quotations received yet for this project."
                           FontSize="13.5"
                           Foreground="{StaticResource InkSoftBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,24"
                           Visibility="Collapsed"/>

                <!-- Quotation Cards Container -->
                <ItemsControl x:Name="QuotationsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Border: Green for L1, Light Line for regular -->
                            <Border CornerRadius="12"
                                    Margin="0,0,0,14"
                                    Padding="18,16"
                                    Background="{Binding IsLowestQuote, Converter={StaticResource BoolToGreenBgConverter}, FallbackValue=White}"
                                    BorderBrush="{Binding IsLowestQuote, Converter={StaticResource BoolToGreenBorderConverter}, FallbackValue=#E2DDD7}"
                                    BorderThickness="1.5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Vendor Name, Badge & Amount -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Vendor Name & L1 Badge -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VendorName}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{StaticResource InkBrush}"/>

                                            <!-- L1 Badge -->
                                            <Border Visibility="{Binding IsLowestQuote, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="#2E7D32"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="L1 · Lowest"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="11"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Amount -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AmountDisplay}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontWeight="Bold"
                                                   FontSize="17"
                                                   Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Bottom Row: Metadata subtext, Remarks, and Action Buttons -->
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SubtextDisplay}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkSoftBrush}"/>
                                            <TextBlock Text="{Binding Remarks}"
                                                       FontSize="11.5"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding Remarks, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- Right Side Actions: Status Combo, Edit, Delete -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="ItemStatusCombo"
                                                      Style="{StaticResource SearchableComboBox}"
                                                      Width="140"
                                                      Height="36"
                                                      Padding="10,0"
                                                      Margin="0,0,10,0"
                                                      FontSize="12.5"
                                                      VerticalContentAlignment="Center"
                                                      SelectedValue="{Binding Status, Mode=OneWay}"
                                                      SelectedValuePath="Content"
                                                      SelectionChanged="ItemStatusCombo_SelectionChanged"
                                                      Tag="{Binding Id}">
                                                <ComboBoxItem Content="Pending Review"/>
                                                <ComboBoxItem Content="Approved"/>
                                                <ComboBoxItem Content="Rejected"/>
                                            </ComboBox>

                                            <Button Content="Edit"
                                                    Style="{StaticResource OutlineButton}"
                                                    Padding="12,0"
                                                    Height="36"
                                                    FontSize="12.5"
                                                    Margin="0,0,6,0"
                                                    Click="EditQuotationButton_Click"
                                                    Tag="{Binding Id}"/>

                                            <Button Content="Delete"
                                                    Style="{StaticResource OutlineButton}"
                                                    Padding="12,0"
                                                    Height="36"
                                                    FontSize="12.5"
                                                    Click="DeleteQuotationButton_Click"
                                                    Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Close"
                        Style="{StaticResource OutlineButton}"
                        Padding="22,9"
                        Height="38"
                        FontSize="13"
                        Margin="0,0,12,0"
                        Click="CloseButton_Click"/>

                <Button Content="+ Add Quotation"
                        Style="{StaticResource PrimaryButton}"
                        Padding="40,9"
                        Height="38"
                        FontSize="13"
                        Click="AddQuotationButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
