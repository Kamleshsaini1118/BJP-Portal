<Window x:Class="StockPortalApp.PoFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter Purchase Orders"
        Width="520" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Filter Icon Badge -->
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FFF5EC" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" 
                              Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Filter Purchase Orders" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Narrow down purchase orders by vendor, product, or date range." FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1" Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="PO Filter" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="450">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="22,16" Padding="22,18">
                <StackPanel>

                    <TextBlock Text="FILTER CRITERIA" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,14"/>

                    <!-- Vendor -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Vendor" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="VendorCombo" Style="{StaticResource RoundedComboBox}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Product -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Product" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ProductCombo" Style="{StaticResource RoundedComboBox}" Cursor="Hand"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,2,0,12"/>

                    <TextBlock Text="DATE RANGE (dd/mm/yyyy)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12"/>

                    <!-- From Date & To Date Row -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="From Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateFromPicker" Language="en-IN" Style="{StaticResource RoundedDatePicker}" Cursor="Hand"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="To Date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DateToPicker" Language="en-IN" Style="{StaticResource RoundedDatePicker}" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear Filters" Style="{StaticResource OutlineButton}" Height="36" Padding="16,0" Margin="0,0,10,0" Click="ClearButton_Click"/>
                <Button Content="Apply Filters" Style="{StaticResource MiniButton}" Height="36" Padding="20,0" Click="ApplyButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>