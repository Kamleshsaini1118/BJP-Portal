<Window x:Class="StockPortalApp.NewUtilityExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StockPortalApp.Helpers"
        Title="New Utility Expense"
        Width="580" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#FFF5EC" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z" 
                              Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="New Utility Expense" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Log a new utility repair or maintenance expense." FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="Expense Entry" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="540">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="20,16" Padding="20,18">
                <StackPanel>
                    
                    <!-- Row 1: Category & Expense Date -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category Dropdown -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryCombo" Style="{StaticResource RoundedComboBox}" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Expense Date -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Expense Date *" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="ExpenseDatePicker" Language="en-IN" Style="{StaticResource RoundedDatePicker}" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Location Input Field (Required) -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Location *" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="Enter location (e.g. Main Office 2nd Floor, Server Room)" 
                                       Visibility="{Binding Text, ElementName=LocationBox, Converter={StaticResource StringToVisibilityConverter}}" 
                                       Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="LocationBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Row 2: Amount & Bill No -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Amount Field -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Amount (₹)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                <TextBlock Text="Enter total amount" 
                                           Visibility="{Binding Text, ElementName=AmountBox, Converter={StaticResource StringToVisibilityConverter}}" 
                                           Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="AmountBox" helpers:NumericInput.Mode="DecimalOnly" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" InputScope="Number" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Bill No Field (Optional) -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bill / Invoice No (Optional)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                <TextBlock Text="Enter bill no" 
                                           Visibility="{Binding Text, ElementName=BillNoBox, Converter={StaticResource StringToVisibilityConverter}}" 
                                           Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="BillNoBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Description Field (Optional) -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Description / Remarks (Optional)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="Enter details about the work done or spare parts used..." 
                                       Visibility="{Binding Text, ElementName=DescriptionBox, Converter={StaticResource StringToVisibilityConverter}}" 
                                       Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,10" VerticalAlignment="Top" IsHitTestVisible="False"/>
                            <TextBox x:Name="DescriptionBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" 
                                     Foreground="{StaticResource InkBrush}" AcceptsReturn="True" TextWrapping="Wrap" Height="68" VerticalContentAlignment="Top"/>
                        </Grid>
                    </StackPanel>

                    <!-- Bill Image Attachment (Optional) -->
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Bill / Receipt Image (Optional)" Style="{StaticResource FieldLabel}"/>
                        <Border Background="#FDFBF7" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Attachment Preview / Icon -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#FFF5EC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True">
                                    <Grid>
                                        <Path x:Name="DefaultFileIcon" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" 
                                              Fill="{StaticResource InkSoftBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="BillImagePreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- Text File Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="BillFileNameText" Text="No file attached" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock x:Name="BillFileSubtext" Text="Attach a PNG, JPG or JPEG bill photo" FontSize="11.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Browse / Remove Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BrowseImageButton" Content="Browse Image..." Style="{StaticResource OutlineButton}" Padding="12,6" Height="32" FontSize="12" Click="BrowseImageButton_Click"/>
                                    <Button x:Name="RemoveImageButton" Content="Remove" Style="{StaticResource OutlineButton}" Padding="10,6" Height="32" FontSize="12" Margin="8,0,0,0" Visibility="Collapsed" Foreground="{StaticResource ErrorBrush}" Click="RemoveImageButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Height="36" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton" Content="Submit Expense" Style="{StaticResource MiniButton}" Height="36" Padding="20,0" Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
