<Window x:Class="StockPortalApp.AddOfficeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Office"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock Text="Add Office" FontFamily="{StaticResource HeadingFont}"
                           FontWeight="Bold" FontSize="19" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="Register a new office or destination for distributions." FontSize="12.5"
                           Foreground="{StaticResource InkSoftBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,24">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Office / Destination Name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource RoundedTextBox}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Address (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AddressBox" Style="{StaticResource RoundedTextBox}"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Contact Person (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ContactPersonBox" Style="{StaticResource RoundedTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Contact Number (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ContactNumberBox" Style="{StaticResource RoundedTextBox}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton" Content="Submit" Style="{StaticResource MiniButton}" Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>