<Window x:Class="StockPortalApp.LedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Food Packets Ledger"
        Width="780"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0"
                Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0"
                    Fill="#FF9933"/>
            <Rectangle Grid.Column="1"
                    Fill="White"/>
            <Rectangle Grid.Column="2"
                    Fill="#138808"/>
        </Grid>

        <!-- Modern Header Panel -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <!-- Book / Ledger Icon Badge -->
                    <Border Width="36"
                            Height="36"
                            CornerRadius="8"
                            Background="#FFF5EC"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"
                              Fill="{StaticResource SaffronDeepBrush}"
                                Stretch="Uniform"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Food Packets Ledger"
                                FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                FontSize="18"
                                Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Every batch added and every dispatch made, most recent first."
                                FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"
                                Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1"
                        Background="#FFF5EC"
                        BorderBrush="#F0D5C0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="Audit History"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Area -->
        <Grid Grid.Row="2"
                Margin="24,20">
            <!-- Empty State Card -->
            <Border x:Name="EmptyText"
                    Visibility="Collapsed"
                    Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="36,40"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="#FFF8F0"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"
                              Fill="{StaticResource InkSoftBrush}"
                                Stretch="Uniform"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.5"/>
                    </Border>
                    <TextBlock Text="No Ledger Entries"
                            FontFamily="{StaticResource HeadingFont}"
                            FontWeight="Bold"
                            FontSize="15"
                            Foreground="{StaticResource InkBrush}"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="No batch or dispatch entries have been recorded yet."
                            Foreground="{StaticResource InkSoftBrush}"
                            FontSize="12.5"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Table Container Card -->
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <DataGrid x:Name="LedgerGrid"
                        Style="{StaticResource AppDataGrid}"
                        MaxHeight="460">

                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping"
                                    Value="Wrap"/>
                            <Setter Property="VerticalAlignment"
                                    Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Type"
                                Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="999"
                                            Padding="10,3"
                                            HorizontalAlignment="Left"
                                            Background="{Binding TypeBadgeBackground}">
                                        <TextBlock Text="{Binding Type}"
                                                FontSize="11.5"
                                                FontWeight="Bold"
                                                Foreground="{Binding TypeBadgeForeground}"
                                                TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Batch ID"
                                Binding="{Binding BatchCode}"
                                Width="0.9*"/>
                        <DataGridTextColumn Header="Item"
                                Binding="{Binding Item}"
                                Width="1.2*"/>
                        <DataGridTextColumn Header="Qty"
                                Binding="{Binding QtyDisplay}"
                                Width="0.7*"/>
                        <DataGridTextColumn Header="Party"
                                Binding="{Binding Party}"
                                Width="1.3*"/>
                        <DataGridTextColumn Header="Date &amp; Time"
                                Binding="{Binding CreatedAtDisplay}"
                                Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button Content="Close"
                        Style="{StaticResource OutlineButton}"
                        Width="90"
                        Height="36"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>