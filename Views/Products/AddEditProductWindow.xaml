<Window x:Class="StockPortalApp.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StockPortalApp.Helpers"
        Title="Add Product"
        Width="520" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Product Box Icon Badge -->
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FFF5EC" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM12 6c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0 8c-1.65 0-3-1.35-3-3s1.35-3 3-3 3 1.35 3 3-1.35 3-3 3z" 
                              Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="Add Product" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Add a new product item to the inventory catalog." FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1" Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="Product Catalog" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Form Card Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="560">
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="22,16" Padding="22,18">
                <StackPanel>

                    <TextBlock Text="PRODUCT CLASSIFICATION" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12"/>

                    <!-- Category Dropdown -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Product Category" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CategoryCombo" Style="{StaticResource RoundedComboBox}"
                                  DisplayMemberPath="Name" SelectionChanged="CategoryCombo_SelectionChanged" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Inline "add new category" row, hidden until "+ Add New Category" is picked -->
                    <Grid x:Name="AddCategoryRow" Margin="0,4,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="8"/>
                            <TextBlock Text="Enter new category name" Foreground="{StaticResource InkSoftBrush}" FontSize="12.5" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewCategoryNameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewCategoryNameBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="NewCategoryNameBox" Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="12.5" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Button Grid.Column="2" Content="Add" Style="{StaticResource MiniButton}" Height="34" Padding="14,0" Click="AddCategoryButton_Click"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,4,0,14"/>

                    <TextBlock Text="PRODUCT DETAILS" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12"/>

                    <!-- Product Name Row -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Product Name" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                            <TextBlock Text="Enter product name" Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="NameBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Product Unit Row -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Product Unit" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="UnitCombo" Style="{StaticResource RoundedComboBox}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Product Code Auto-Generated Preview -->
                    <!-- <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Product Code" Style="{StaticResource FieldLabel}"/>
                        <Border Background="#FBF5EE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                            <TextBox x:Name="CodePreviewBox" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" IsReadOnly="True" Foreground="{StaticResource InkSoftBrush}" Text="Auto-generated when you click Submit" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel> -->

                    <!-- Min Qty & Avg Price Row -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Min Qty -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minimum Qty (Auto Alert)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                <TextBlock Text="e.g. 5 (min threshold)" Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MinQtyBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=MinQtyBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="MinQtyBox" helpers:NumericInput.Mode="DigitsOnly" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" InputScope="Number" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Avg Price -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Average Price (optional)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="10"/>
                                <TextBlock Text="e.g. 250 (avg cost)" Foreground="{StaticResource InkSoftBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AvgPriceBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=AvgPriceBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="AvgPriceBox" helpers:NumericInput.Mode="DecimalOnly" Background="Transparent" BorderThickness="0" Padding="14,10" FontSize="13" Foreground="{StaticResource InkBrush}" InputScope="Number" VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Height="36" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton" Content="Submit Product" Style="{StaticResource MiniButton}" Height="36" Padding="20,0" Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>