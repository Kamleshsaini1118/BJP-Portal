<Window x:Class="StockPortalApp.AddDamageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StockPortalApp.Helpers"
        Title="Add Damage"
        Width="720"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0"
                Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0"
                    Fill="#FF9933"/>
            <Rectangle Grid.Column="1"
                    Fill="White"/>
            <Rectangle Grid.Column="2"
                    Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <!-- Warning Icon Badge -->
                    <Border Width="36"
                            Height="36"
                            CornerRadius="8"
                            Background="#FDE8E8"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Path Data="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                              Stroke="{StaticResource ErrorBrush}"
                                StrokeThickness="2"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                              Stretch="Uniform"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Add Damage Report"
                                FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold"
                                FontSize="18"
                                Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Report a damaged or broken item from stock inventory."
                                FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"
                                Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1"
                        Background="#FDE8E8"
                        BorderBrush="#F8C4C4"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="Damage Log"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{StaticResource ErrorBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Compact Form Body Card -->
        <ScrollViewer Grid.Row="2"
                VerticalScrollBarVisibility="Auto"
                MaxHeight="520">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="22,16"
                    Padding="22,20">
                <StackPanel>

                    <!-- SECTION 1: ITEM DETAILS (Row 1 with 3 input boxes) -->
                    <TextBlock Text="ITEM DETAILS"
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkSoftBrush}"
                            Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Box 1: Category -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category"
                                    Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryCombo"
                                    Style="{StaticResource RoundedComboBox}"
                                      SelectionChanged="CategoryCombo_SelectionChanged" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Box 2: Item -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Item Name"
                                    Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ItemCombo"
                                    Style="{StaticResource RoundedComboBox}"
                                      SelectionChanged="ItemCombo_SelectionChanged" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Box 3: Quantity -->
                        <StackPanel Grid.Column="4">
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,4">
                                <TextBlock Text="Quantity"
                                        Style="{StaticResource FieldLabel}"
                                        Margin="0"/>
                                <TextBlock x:Name="AvailableStockText"
                                        Text=""
                                        FontSize="11"
                                        Foreground="{StaticResource InkSoftBrush}"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Border Background="#FFFCF9"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"/>
                                <TextBlock Text="e.g. 5"
                                        Visibility="{Binding Text, ElementName=QtyBox, Converter={StaticResource StringToVisibilityConverter}}"
                                        Foreground="{StaticResource InkSoftBrush}"
                                        FontSize="13"
                                        Margin="14,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <TextBox x:Name="QtyBox"
                                        helpers:NumericInput.Mode="DigitsOnly"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="14,10"
                                        FontSize="13"
                                        Foreground="{StaticResource InkBrush}"
                                        InputScope="Number"
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="0,2,0,16"/>

                    <!-- SECTION 2: REPORTEE DETAILS (Row 2 with 3 input boxes) -->
                    <TextBlock Text="REPORTEE DETAILS"
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkSoftBrush}"
                            Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Box 4: Reportee Name -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Reportee Name"
                                    Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"/>
                                <TextBlock Text="Enter reportee name"
                                        Visibility="{Binding Text, ElementName=ReporteeNameBox, Converter={StaticResource StringToVisibilityConverter}}"
                                        Foreground="{StaticResource InkSoftBrush}"
                                        FontSize="13"
                                        Margin="14,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <TextBox x:Name="ReporteeNameBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="14,10"
                                        FontSize="13"
                                        Foreground="{StaticResource InkBrush}"
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Box 5: Reportee Number -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reportee Number"
                                    Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"/>
                                <TextBlock Text="Enter contact number"
                                        Visibility="{Binding Text, ElementName=ReporteeNumberBox, Converter={StaticResource StringToVisibilityConverter}}"
                                        Foreground="{StaticResource InkSoftBrush}"
                                        FontSize="13"
                                        Margin="14,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <TextBox x:Name="ReporteeNumberBox"
                                        helpers:NumericInput.Mode="MobileNumber"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="14,10"
                                        FontSize="13"
                                        Foreground="{StaticResource InkBrush}"
                                        InputScope="TelephoneNumber"
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Box 6: Reportee Position -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Reportee Position"
                                    Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Border Background="#FFFCF9"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"/>
                                <TextBlock Text="e.g. Store Manager"
                                        Visibility="{Binding Text, ElementName=ReporteePositionBox, Converter={StaticResource StringToVisibilityConverter}}"
                                        Foreground="{StaticResource InkSoftBrush}"
                                        FontSize="13"
                                        Margin="14,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <TextBox x:Name="ReporteePositionBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="14,10"
                                        FontSize="13"
                                        Foreground="{StaticResource InkBrush}"
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="0,2,0,16"/>

                    <!-- SECTION 3: REMARK (Full Width) -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Remark (optional)"
                                Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Border Background="#FFFCF9"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"/>
                            <TextBlock Text="Enter damage details or reason..."
                                    Visibility="{Binding Text, ElementName=RemarkBox, Converter={StaticResource StringToVisibilityConverter}}"
                                    Foreground="{StaticResource InkSoftBrush}"
                                    FontSize="13"
                                    Margin="14,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>
                            <TextBox x:Name="RemarkBox"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="14,10"
                                    FontSize="13"
                                    Foreground="{StaticResource InkBrush}"
                                    VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Border Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="0,2,0,16"/>

                    <!-- SECTION 4: DAMAGE IMAGES ATTACHMENT -->
                    <TextBlock Text="ATTACH DAMAGE IMAGES (OPTIONAL)"
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkSoftBrush}"
                            Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <!-- State 1: No Images attached -->
                        <Border x:Name="NoImageBorder"
                                Background="#FFFCF9"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="16,12"
                                Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="#F0F4F8"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                          Fill="{StaticResource InkSoftBrush}"
                                            Stretch="Uniform"
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Attach Photos / Proof of Damage"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock Text="Select one or multiple PNG, JPG, JPEG, BMP or GIF files"
                                            FontSize="11"
                                            Foreground="{StaticResource InkSoftBrush}"
                                            Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        x:Name="AttachImageButton"
                                        Content="Browse Images"
                                        Style="{StaticResource OutlineButton}"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Center"
                                        Click="AttachImageButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- State 2: Multiple Images attached preview container -->
                        <Border x:Name="ImagePreviewBorder"
                                Background="#FFFCF9"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="AttachedCountText"
                                            Text="Attached Photos (0)"
                                            FontWeight="Bold"
                                            FontSize="12.5"
                                            Foreground="{StaticResource InkBrush}"
                                            VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                        <Button Content="+ Add More"
                                                Style="{StaticResource OutlineButton}"
                                                Height="28"
                                                Padding="10,0"
                                                FontSize="11.5"
                                                Margin="0,0,6,0"
                                                Click="AttachImageButton_Click"/>
                                        <Button Content="Clear All"
                                                Style="{StaticResource OutlineButton}"
                                                Foreground="#C0392B"
                                                Height="28"
                                                Padding="10,0"
                                                FontSize="11.5"
                                                Click="RemoveAllImages_Click"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                        HorizontalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AttachedImagesControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,8,8">
                                                    <Border Width="72"
                                                            Height="72"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            Background="#EAEAEA"
                                                            BorderBrush="{StaticResource LineBrush}"
                                                            BorderThickness="1">
                                                        <Image Source="{Binding PreviewImage}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Button Style="{StaticResource OutlineButton}"
                                                            Width="22"
                                                            Height="22"
                                                            Padding="0"
                                                            Margin="0,2,2,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="#EEFFFFFF"
                                                            BorderThickness="0"
                                                            Click="RemoveSingleImage_Click"
                                                            ToolTip="Remove image">
                                                        <TextBlock Text="✕"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="#C0392B"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="26,14">
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        Width="90"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton"
                        Content="Submit Report"
                        Style="{StaticResource MiniButton}"
                        Height="36"
                        Padding="24,0"
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>