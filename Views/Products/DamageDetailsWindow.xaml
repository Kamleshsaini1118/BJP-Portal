<Window x:Class="StockPortalApp.DamageDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Damage Details"
        Width="580" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CreamBrush}" FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Accent Thread Line -->
        <Grid Grid.Row="0" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#FF9933"/>
            <Rectangle Grid.Column="1" Fill="White"/>
            <Rectangle Grid.Column="2" Fill="#138808"/>
        </Grid>

        <!-- Modern Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Damage Details Badge Icon -->
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FDE8E8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" 
                              Stroke="{StaticResource ErrorBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Damage Details" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tag Badge -->
                <Border Grid.Column="1" Background="#FDE8E8" BorderBrush="#F8C4C4" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="Report Summary" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="500">
            <StackPanel Margin="24,20">
                <!-- Metadata Card -->
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="REPORT INFORMATION" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,14"/>
                        <StackPanel x:Name="MetaPanel"/>
                    </StackPanel>
                </Border>

                <!-- Photos Section Card -->
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="ATTACHED PHOTOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,10"/>
                        
                        <!-- Empty State -->
                        <Grid x:Name="NoPhotosPanel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#FFF8F0" Margin="0,0,10,0">
                                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" 
                                          Fill="{StaticResource InkSoftBrush}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                </Border>
                                <TextBlock x:Name="NoPhotosText" Text="No photos were attached to this damage report." FontSize="12" Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Photos Display Gallery (Images ONLY, no path or buttons) -->
                        <ScrollViewer x:Name="PhotoPreviewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PhotosItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#F9F9F9" Margin="0,0,10,10">
                                            <Image Source="{Binding}" MaxHeight="180" MaxWidth="280" Stretch="Uniform"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Print Receipt" Style="{StaticResource OutlineButton}" Height="36" Padding="16,0" Margin="0,0,10,0" Click="PrintReceiptButton_Click"/>
                <Button Content="Close" Style="{StaticResource MiniButton}" Height="36" Width="90" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>