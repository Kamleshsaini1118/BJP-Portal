                                      Style="{StaticResource AppDataGrid}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vendor Name"
                                                        Binding="{Binding Name}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="130"
                                                        Width="1.3*"/>
                                    <DataGridTextColumn Header="GST"
                                                        Binding="{Binding Gst}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="150"
                                                        Width="1.1*"/>
                                    <DataGridTextColumn Header="Contact Person"
                                                        Binding="{Binding ContactPerson}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="130"
                                                        Width="1*"/>
                                    <DataGridTextColumn Header="Number"
                                                        Binding="{Binding ContactNumber}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="110"
                                                        Width="0.9*"/>
                                    <DataGridTextColumn Header="Email"
                                                        Binding="{Binding Email}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="160"
                                                        Width="1.3*"/>
                                    <DataGridTextColumn Header="Address"
                                                        Binding="{Binding Address}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="160"
                                                        Width="1.5*"/>
                                    <DataGridTextColumn Header="Created At"
                                                        Binding="{Binding CreatedAt}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="110"
                                                        Width="1*"/>
                                    <DataGridTemplateColumn Header="Actions"
                                                            MinWidth="220"
                                                            Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="View Details"
                                                            Style="{StaticResource OutlineButton}"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Margin="0,0,6,0"
                                                            Click="ViewVendorButton_Click"/>
                                                    <Button Content="Edit"
                                                            Style="{StaticResource OutlineButton}"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Click="EditVendorButton_Click"/>

                                                    <!-- Deactivate / Activate Button -->
                                                    <Button Padding="10,6"
                                                            Margin="6,0,0,0"
                                                            FontSize="12"
                                                            Cursor="Hand"
                                                            Click="ToggleVendorStatusButton_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                   BasedOn="{StaticResource OutlineButton}">
                                                                <!-- Default when IsActive is true: Show red Deactivate button -->
                                                                <Setter Property="Content"
                                                                        Value="Deactivate"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#DC2626"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#FCA5A5"/>
                                                                <!-- Trigger when IsActive is false: Show green Activate button -->
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                                 Value="False">
                                                                        <Setter Property="Content"
                                                                                Value="Activate"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="#16A34A"/>
                                                                        <Setter Property="BorderBrush"
                                                                                Value="#86EFAC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ================= CATEGORIES PANEL ================= -->
                    <Border x:Name="PanelCategory"
                            Style="{StaticResource PlaceholderPanel}"
                            Visibility="Collapsed"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Header & Filter Row -->
                            <Grid Grid.Row="0"
                                    Margin="22,18,22,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title & Search / Status / Add Category Button -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Categories"
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <!-- Search Box -->
                                        <Border Width="190"
                                                Height="34"
                                                Background="#FFFCF9"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                Padding="8,0"
                                                Margin="0,0,10,0">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Path Grid.Column="0"
                                                      Data="M10 17 A7 7 0 1 1 17 10 A7 7 0 0 1 10 17 Z M15 15 L20 20"
                                                      Stroke="{StaticResource InkSoftBrush}"
                                                      StrokeThickness="1.6"
                                                      Width="13"
                                                      Height="13"
                                                      Stretch="Uniform"
                                                      Margin="2,0,6,0"
                                                      VerticalAlignment="Center"/>

                                                <Grid Grid.Column="1">
                                                    <TextBlock x:Name="CategoryPlaceholderText"
                                                               Text="Search categories..."
                                                               Visibility="{Binding Text, ElementName=CategorySearchBox, Converter={StaticResource StringToVisibilityConverter}}"
                                                               Foreground="{StaticResource InkSoftBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"/>

                                                    <TextBox x:Name="CategorySearchBox"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             FontSize="12"
                                                             Foreground="{StaticResource InkBrush}"
                                                             VerticalContentAlignment="Center"
                                                             Padding="0"
                                                             TextChanged="CategorySearchBox_TextChanged"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Status Filter Dropdown -->
                                        <ComboBox x:Name="CategoryStatusFilterCombo"
                                                  Width="130"
                                                  Height="34"
                                                  Margin="0,0,10,0"
                                                  Style="{StaticResource RoundedComboBox}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="CategoryStatusFilterCombo_SelectionChanged">
                                            <ComboBoxItem Content="All statuses"/>
                                            <ComboBoxItem Content="Active"/>
                                            <ComboBoxItem Content="Inactive"/>
                                        </ComboBox>

                                        <!-- + Add Category Button -->
                                        <Button Content="+ Add Category"
                                                Style="{StaticResource MiniButton}"
                                                Padding="14,5"
                                                Height="34"
                                                FontSize="12.5"
                                                Click="AddCategoryButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Banner note matching Screenshot 1 -->
                                <TextBlock Grid.Row="1"
                                           Text="Deactivating a category hides it — and every product in it — from new purchases, POs, distributions, issues and damage entries. Past records and reports are not affected."
                                           FontSize="11.5"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           Margin="0,10,0,0"/>
                            </Grid>

                            <!-- Divider line -->
                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{StaticResource LineBrush}"/>

                            <!-- Categories DataGrid -->
                            <DataGrid x:Name="CategoriesGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource AppDataGrid}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <!-- CATEGORY -->
                                    <DataGridTextColumn Header="CATEGORY"
                                                        Binding="{Binding Name}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        FontWeight="SemiBold"
                                                        MinWidth="160"
                                                        Width="1.8*"/>

                                    <!-- CODE PREFIX -->
                                    <DataGridTextColumn Header="CODE PREFIX"
                                                        Binding="{Binding Prefix}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="100"
                                                        Width="1*"/>

                                    <!-- PRODUCTS -->
                                    <DataGridTextColumn Header="PRODUCTS"
                                                        Binding="{Binding ProductCount}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="90"
                                                        Width="0.9*"/>

                                    <!-- STATUS -->
                                    <DataGridTemplateColumn Header="STATUS"
                                                            MinWidth="100"
                                                            Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10"
                                                        Padding="10,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="#DCFCE7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                        Value="False">
                                                                    <Setter Property="Background"
                                                                            Value="#F3F4F6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontWeight="SemiBold"
                                                               FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text"
                                                                        Value="Active"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#15803D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                            Value="False">
                                                                        <Setter Property="Text"
                                                                                Value="Inactive"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="#6B7280"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- ACTIONS -->
                                    <DataGridTemplateColumn Header="ACTIONS"
                                                            MinWidth="120"
                                                            Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="12,4"
                                                        FontSize="11.5"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand"
                                                        Click="ToggleCategoryStatusButton_Click"
                                                        Tag="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                                BasedOn="{StaticResource OutlineButton}">
                                                            <Setter Property="Content"
                                                                    Value="Deactivate"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#DC2626"/>
                                                            <Setter Property="BorderBrush"
                                                                    Value="#FCA5A5"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                        Value="False">
                                                                    <Setter Property="Content"
                                                                            Value="Activate"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="#16A34A"/>
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#86EFAC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border x:Name="PanelAddProduct"
                            Style="{StaticResource PlaceholderPanel}"
                            Visibility="Collapsed"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="22,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Products"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <!-- Compact Search Box with Icon & Placeholder -->
                                    <Border Width="180"
                                            Height="34"
                                            Background="#FFFCF9"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="8,0"
                                            Margin="0,0,10,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Search Icon -->
                                            <Path Grid.Column="0"
                                                  Data="M10 17 A7 7 0 1 1 17 10 A7 7 0 0 1 10 17 Z M15 15 L20 20"
                                                  Stroke="{StaticResource InkSoftBrush}"
                                                  StrokeThickness="1.6"
                                                  Width="13"
                                                  Height="13"
                                                  Stretch="Uniform"
                                                  Margin="2,0,6,0"
                                                  VerticalAlignment="Center"/>

                                            <Grid Grid.Column="1">
                                                <!-- Placeholder Text -->
                                                <TextBlock x:Name="ProductPlaceholderText"
                                                           Text="Search Products...."
                                                           Visibility="{Binding Text, ElementName=ProductSearchBox, Converter={StaticResource StringToVisibilityConverter}}"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>

                                                <!-- Search TextBox -->
                                                <TextBox x:Name="ProductSearchBox"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="12"
                                                         Foreground="{StaticResource InkBrush}"
                                                         VerticalContentAlignment="Center"
                                                         Padding="0"
                                                         TextChanged="ProductSearchBox_TextChanged"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Button Content="Export to Excel"
                                            Style="{StaticResource OutlineButton}"
                                            Padding="12,5"
                                            Height="34"
                                            FontSize="12.5"
                                            Margin="0,0,10,0"
                                            Click="ExportProductsButton_Click"/>
                                    <Button Content="+ Add Product"
                                            Style="{StaticResource MiniButton}"
                                            Padding="14,5"
                                            Height="34"
                                            FontSize="12.5"
                                            Click="AddProductButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{StaticResource LineBrush}"/>

                            <DataGrid x:Name="ProductsGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource AppDataGrid}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product Code"
                                                        Binding="{Binding ProductCode}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="120"
                                                        Width="1*"/>
                                    <DataGridTextColumn Header="Product Name"
                                                        Binding="{Binding Name}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="160"
                                                        Width="1.6*"/>
                                    <DataGridTextColumn Header="Category"
                                                        Binding="{Binding Category}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="130"
                                                        Width="1.1*"/>
                                    <DataGridTemplateColumn Header="TYPE"
                                            MinWidth="110"
                                            Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="999"
                                                        Padding="10,3"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding ProductTypeBadgeBackground}">
                                                    <TextBlock Text="{Binding ProductType}"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding ProductTypeBadgeForeground}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Unit"
                                                        Binding="{Binding Unit}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="80"
                                                        Width="0.7*"/>
                                    <DataGridTextColumn Header="Min Qty"
                                                        Binding="{Binding MinQtyDisplay}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="90"
                                                        Width="0.8*"/>
                                    <DataGridTextColumn Header="Avg Price"
                                                        Binding="{Binding AvgPriceDisplay}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="100"
                                                        Width="0.8*"/>
                                    <DataGridTextColumn Header="Created At"
                                                        Binding="{Binding CreatedAt}"
                                                        ElementStyle="{StaticResource WrapTextCellStyle}"
                                                        MinWidth="110"
                                                        Width="0.8*"/>
                                    <DataGridTemplateColumn Header="Actions"
                                                            MinWidth="160"
                                                            Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Edit"
                                                            Style="{StaticResource OutlineButton}"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Margin="0,0,6,0"
                                                            Click="EditProductButton_Click"/>
                                                    <!-- <Button Content="Delete"
                                                            Style="{StaticResource OutlineButton}"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Foreground="{StaticResource ErrorBrush}"
                                                            Click="DeleteProductButton_Click"/> -->

                                                    <!-- Deactivate / Activate Button -->
                                                    <Button Padding="10,6"
                                                            FontSize="12"
                                                            Cursor="Hand"
                                                            Click="ToggleProductStatusButton_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                   BasedOn="{StaticResource OutlineButton}">
                                                                <!-- Default when IsActive is true: Show red Deactivate button -->
                                                                <Setter Property="Content"
                                                                        Value="Deactivate"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#DC2626"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#FCA5A5"/>
                                                                <!-- Trigger when IsActive is false: Show green Activate button -->
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                                 Value="False">
                                                                        <Setter Property="Content"
                                                                                Value="Activate"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="#16A34A"/>
                                                                        <Setter Property="BorderBrush"
                                                                                Value="#86EFAC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ============ QUOTATION PANEL ============ -->
                    <Border x:Name="PanelQuotation"
                            Style="{StaticResource PlaceholderPanel}"
                            Padding="0"
                            Visibility="Collapsed"
                            BorderThickness="0"
                            Background="Transparent">
                        <!-- Main Projects Card -->
                        <Border Background="White"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header & Controls -->
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="0"
                                               Text="Projects"
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Controls: Search, + Upload Quotation, + Create Project -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Search Box Container with Magnifying Glass Icon -->
                                        <Border Background="#FFFCF9"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="10"
                                                Width="230"
                                                Height="38"
                                                Margin="0,0,12,0"
                                                Padding="10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Search Icon -->
                                                <Path Grid.Column="0"
                                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                                      Fill="{StaticResource InkSoftBrush}"
                                                      Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>

                                                <!-- Search Input -->
                                                <TextBox x:Name="SearchProjectsBox"
                                                         Grid.Column="1"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="13"
                                                         Foreground="{StaticResource InkBrush}"
                                                         CaretBrush="{StaticResource InkBrush}"
                                                         VerticalContentAlignment="Center"
                                                         Tag="Search projects..."
                                                         TextChanged="SearchProjectsBox_TextChanged">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <Grid>
                                                                            <TextBlock x:Name="PlaceholderText"
                                                                                       Text="{TemplateBinding Tag}"
                                                                                       Foreground="{StaticResource InkSoftBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="{TemplateBinding FontSize}"
                                                                                       IsHitTestVisible="False"
                                                                                       Opacity="0.65"
                                                                                       Visibility="Collapsed"/>
                                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                                          VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="Text"
                                                                                     Value="">
                                                                                <Setter TargetName="PlaceholderText"
                                                                                        Property="Visibility"
                                                                                        Value="Visible"/>
                                                                            </Trigger>
                                                                            <Trigger Property="Text"
                                                                                     Value="{x:Null}">
                                                                                <Setter TargetName="PlaceholderText"
                                                                                        Property="Visibility"
                                                                                        Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </Border>

                                        <!-- Upload Quotation Button -->
