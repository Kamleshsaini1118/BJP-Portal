<Window x:Class="StockPortalApp.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:reports="clr-namespace:StockPortalApp.Views.Reports"
        Title="Stock Portal"
        Width="1360"
        Height="860"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ TOP HEADER BAR ============ -->
        <Border Grid.Row="0"
                Background="{StaticResource SidebarGradient}"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & App Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="9"
                            Background="#26FFFFFF"
                            BorderBrush="#59FFFFFF"
                            BorderThickness="1">
                        <Viewbox Width="18"
                                 Height="18">
                            <Canvas Width="24"
                                    Height="24">
                                <Ellipse Canvas.Left="2"
                                         Canvas.Top="2"
                                         Width="20"
                                         Height="20"
                                         Stroke="White"
                                         StrokeThickness="1.4"/>
                                <Line X1="12"
                                      Y1="2"
                                      X2="12"
                                      Y2="22"
                                      Stroke="White"
                                      StrokeThickness="0.8"
                                      Opacity="0.5"/>
                                <Line X1="2"
                                      Y1="12"
                                      X2="22"
                                      Y2="12"
                                      Stroke="White"
                                      StrokeThickness="0.8"
                                      Opacity="0.5"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Stock Portal"
                               Foreground="White"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="Bold"
                               FontSize="16.5"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Right Side Profile & Sign Out Button -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- User Avatar Badge -->
                    <Border Background="#26FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6,4,12,4"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="26"
                                    Height="26"
                                    CornerRadius="6"
                                    Background="{StaticResource AvatarGradient}">
                                <TextBlock x:Name="UserInitialsText"
                                           Text="TR"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="UserNameText"
                                       Text="trial"
                                       FontWeight="SemiBold"
                                       FontSize="12.5"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sign Out Button -->
                    <Button x:Name="SignOutButton"
                            Click="SignOutButton_Click"
                            Cursor="Hand"
                            Height="34"
                            Padding="12,0"
                            Background="#20FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Viewbox Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0">
                                            <Canvas Width="24"
                                                    Height="24">
                                                <Path Data="M9 21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9"
                                                      Stroke="White"
                                                      StrokeThickness="1.8"/>
                                                <Path Data="M16 17 L21 12 L16 7 M21 12 H9"
                                                      Stroke="White"
                                                      StrokeThickness="1.8"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Sign Out"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Background"
                                                Value="#38FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ SUB-HEADER HORIZONTAL NAVIGATION BAR ============ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False">

                <ScrollViewer.Resources>
                    <!-- Sleek 6px horizontal scrollbar -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Height"
                                Value="6"/>
                        <Setter Property="MinHeight"
                                Value="6"/>
                        <Setter Property="Margin"
                                Value="0,1,0,0"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid x:Name="Bg"
                                          Background="Transparent"
                                          Height="6">
                                        <Track x:Name="PART_Track"
                                               IsDirectionReversed="False"
                                               Height="6">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                              Opacity="0"
                                                              Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand"
                                                              Opacity="0"
                                                              Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Height="6"
                                                       MinWidth="40">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#D9531E"
                                                                    CornerRadius="3"
                                                                    Height="6"
                                                                    Opacity="0.65"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Orientation="Horizontal"
                            Margin="16,0">
                    <!-- NavDashboard -->
                    <ToggleButton x:Name="NavDashboard"
                                  Style="{StaticResource TopNavItemStyle}"
                                  IsChecked="True"
                                  Checked="NavItem_Checked"
                                  Tag="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Rectangle Canvas.Left="3"
                                               Canvas.Top="3"
                                               Width="8"
                                               Height="8"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="13"
                                               Canvas.Top="3"
                                               Width="8"
                                               Height="8"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="3"
                                               Canvas.Top="13"
                                               Width="8"
                                               Height="8"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="13"
                                               Canvas.Top="13"
                                               Width="8"
                                               Height="8"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Dashboard"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavFoodPackets -->
                    <ToggleButton x:Name="NavFoodPackets"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="food-packets">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Rectangle Canvas.Left="3"
                                               Canvas.Top="7"
                                               Width="18"
                                               Height="13"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Path Data="M3 11 H21 M8 7 V5 A2,2 0 0 1 10,3 H14 A2,2 0 0 1 16,5 V7"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Food Packets"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavFixedAssets -->
                    <ToggleButton x:Name="NavFixedAssets"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="fixed-assets">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Rectangle Canvas.Left="4"
                                               Canvas.Top="4"
                                               Width="16"
                                               Height="16"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Path Data="M4 10 H20 M10 4 V20"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Fixed Assets"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavStockReport -->
                    <ToggleButton x:Name="NavStockReport"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="stock-report">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M4 19 H20 M7 15 V11 M12 15 V7 M17 15 V7"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Stock Report"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavDamage -->
                    <ToggleButton x:Name="NavDamage"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="damage">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M10.29 3.86 L1.82 18 A2,2 0 0 0 3.53,21 H20.47 A2,2 0 0 0 22.18,18 L13.71 3.86 A2,2 0 0 0 10.29,3.86 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M12 9 V13 M12 17 L12.01 17"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Damage"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavRaisePo -->
                    <ToggleButton x:Name="NavRaisePo"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="raise-po">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M9 12 H15 M9 16 H15 M9 8 H10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M6 3 H15 L20 8 V21 A1,1 0 0 1 19,22 H6 A1,1 0 0 1 5,21 V4 A1,1 0 0 1 6,3 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Raise PO"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavAddPurchase -->
                    <ToggleButton x:Name="NavAddPurchase"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="add-purchase">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Ellipse Canvas.Left="7.6"
                                             Canvas.Top="18.6"
                                             Width="2.8"
                                             Height="2.8"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="1.8"/>
                                    <Ellipse Canvas.Left="15.6"
                                             Canvas.Top="18.6"
                                             Width="2.8"
                                             Height="2.8"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="1.8"/>
                                    <Path Data="M2 3 H4 L6.4 15.2 A2,2 0 0 0 8.4,16.8 H15.6 A2,2 0 0 0 17.6,15.2 L21 7 H6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Purchase"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavQuotation (NEW) -->
                    <ToggleButton x:Name="NavQuotation"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="quotation">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M14 2V8H20 M16 13H8 M16 17H8 M10 9H8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Quotation"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavAddDistribution -->
                    <ToggleButton x:Name="NavAddDistribution"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="add-export">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M12 3 V15 M7 8 L12 3 L17 8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M4 15 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V15"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Distribution"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavIssueBorrow -->
                    <ToggleButton x:Name="NavIssueBorrow"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="issue-borrow">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M6 3 H18 A1,1 0 0 1 19,4 V21 L12 17 L5 21 V4 A1,1 0 0 1 6,3 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Issue Goods"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavAddVendor -->
                    <ToggleButton x:Name="NavAddVendor"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="add-vendor">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Ellipse Canvas.Left="8.8"
                                             Canvas.Top="4.8"
                                             Width="6.4"
                                             Height="6.4"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="1.8"/>
                                    <Path Data="M5 20 C5 16.4 8 14 12 14 S19 16.4 19 20"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Vendor"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavAddProduct -->
                    <ToggleButton x:Name="NavAddProduct"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="add-product">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M21 8 L12 3 L3 8 L12 13 L21 8 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M3 8 V16 L12 21 L21 16 V8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M12 13 V21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Product"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavUtilityReminder (NEW) -->
                    <ToggleButton x:Name="NavUtilityReminder"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="utility-reminder">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M18 8A6 6 0 0 0 6 8C6 15 3 17 3 17H21S18 15 18 8 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M13.73 21A2 2 0 0 1 10.27 21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Utility Reminder"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavReports (NEW) -->
                    <ToggleButton x:Name="NavReports"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="reports">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Reports"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ MAIN CONTENT AREA ============ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title Header -->
            <Border Grid.Row="0"
                    Padding="32,20,32,10">
                <TextBlock x:Name="PanelTitleText"
                           Text="Dashboard Overview"
                           FontFamily="{StaticResource HeadingFont}"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="{StaticResource InkBrush}"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- .dash-body -->
            <Grid Grid.Row="1"
                  Margin="32,10,32,32">
                <Grid>
                    <!-- Each panel is a placeholder for now — built out in its own phase -->
                    <!-- <Border x:Name="PanelFoodPackets" Style="{StaticResource PlaceholderPanel}" Padding="0" Visibility="Collapsed"> -->
                    <Border x:Name="PanelDashboard"
                            Style="{StaticResource PlaceholderPanel}"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <!-- Date Filter Card -->
                                <Border Background="White"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="20,16"
                                        Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Title & Icon -->
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,24,0">
                                        <Border Width="34"
                                                Height="34"
                                                CornerRadius="8"
                                                Background="#FFF5EC"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <Path Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"
                                                  Fill="{StaticResource SaffronDeepBrush}"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Filter Overview"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource InkBrush}"/>
                                            <TextBlock Text="Format: dd/mm/yyyy"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Date Inputs & Clear Button -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="From Date"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <DatePicker x:Name="DashDateFrom"
