                                                Margin="0,0,10,0"
                                                Click="UploadQuotationButton_Click"/>

                                        <!-- Create Project Button -->
                                        <Button Content="+ Create Project"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="18,0"
                                                Height="38"
                                                FontSize="12.5"
                                                Click="CreateProjectButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Row="1"
                                        Background="{StaticResource LineBrush}"
                                        Margin="0,0,0,16"/>

