<Window x:Class="StockPortalApp.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:reports="clr-namespace:StockPortalApp.Views.Reports"
        Title="Stock Portal"
        Width="1360"
        Height="860"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ TOP HEADER BAR ============ -->
        <Border Grid.Row="0"
                Background="{StaticResource SidebarGradient}"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & App Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="9"
                            Background="#26FFFFFF"
                            BorderBrush="#59FFFFFF"
                            BorderThickness="1">
                        <Viewbox Width="18"
                                 Height="18">
                            <Canvas Width="24"
                                    Height="24">
                                <Ellipse Canvas.Left="2"
                                         Canvas.Top="2"
                                         Width="20"
                                         Height="20"
                                         Stroke="White"
                                         StrokeThickness="1.4"/>
                                <Line X1="12"
                                      Y1="2"
                                      X2="12"
                                      Y2="22"
                                      Stroke="White"
                                      StrokeThickness="0.8"
                                      Opacity="0.5"/>
                                <Line X1="2"
                                      Y1="12"
                                      X2="22"
                                      Y2="12"
                                      Stroke="White"
                                      StrokeThickness="0.8"
                                      Opacity="0.5"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Stock Portal"
                               Foreground="White"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="Bold"
                               FontSize="16.5"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Right Side Profile & Sign Out Button -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- User Avatar Badge -->
                    <Border Background="#26FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6,4,12,4"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="26"
                                    Height="26"
                                    CornerRadius="6"
                                    Background="{StaticResource AvatarGradient}">
                                <TextBlock x:Name="UserInitialsText"
                                           Text="TR"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="UserNameText"
                                       Text="trial"
                                       FontWeight="SemiBold"
                                       FontSize="12.5"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sign Out Button -->
                    <Button x:Name="SignOutButton"
                            Click="SignOutButton_Click"
                            Cursor="Hand"
                            Height="34"
                            Padding="12,0"
                            Background="#20FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Viewbox Width="14"
                                                 Height="14"
                                                 Margin="0,0,6,0">
                                            <Canvas Width="24"
                                                    Height="24">
                                                <Path Data="M9 21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9"
                                                      Stroke="White"
                                                      StrokeThickness="1.8"/>
                                                <Path Data="M16 17 L21 12 L16 7 M21 12 H9"
                                                      Stroke="White"
                                                      StrokeThickness="1.8"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Sign Out"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Background"
                                                Value="#38FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ SUB-HEADER HORIZONTAL NAVIGATION BAR ============ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False">

                <ScrollViewer.Resources>
                    <!-- Sleek 6px horizontal scrollbar -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Height"
                                Value="6"/>
                        <Setter Property="MinHeight"
                                Value="6"/>
                        <Setter Property="Margin"
                                Value="0,1,0,0"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid x:Name="Bg"
                                          Background="Transparent"
                                          Height="6">
                                        <Track x:Name="PART_Track"
                                               IsDirectionReversed="False"
                                               Height="6">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                              Opacity="0"
                                                              Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand"
                                                              Opacity="0"
                                                              Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Height="6"
                                                       MinWidth="40">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#D9531E"
                                                                    CornerRadius="3"
                                                                    Height="6"
                                                                    Opacity="0.65"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Orientation="Horizontal"
                            Margin="16,0">
                    <!-- NavDashboard -->
                    <ToggleButton x:Name="NavDashboard"
                                  Style="{StaticResource TopNavItemStyle}"
                                  IsChecked="True"
                                  Checked="NavItem_Checked"
                                  Tag="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Rectangle Canvas.Left="3"
                                               Canvas.Top="3"
                                               Width="8"
                                               Height="8"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="13"
                                               Canvas.Top="3"
                                               Width="8"
                                               Height="8"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="3"
                                               Canvas.Top="13"
                                               Width="8"
                                               Height="8"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="13"
                                               Canvas.Top="13"
                                               Width="8"
                                               Height="8"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Dashboard"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavFoodPackets -->
                    <ToggleButton x:Name="NavFoodPackets"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="food-packets">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Rectangle Canvas.Left="3"
                                               Canvas.Top="7"
                                               Width="18"
                                               Height="13"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               StrokeThickness="1.8"/>
                                    <Path Data="M3 11 H21 M8 7 V5 A2,2 0 0 1 10,3 H14 A2,2 0 0 1 16,5 V7"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Food Packets"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavFixedAssets -->
                    <Grid x:Name="NavFixedAssetsContainer"
                          MouseEnter="NavFixedAssetsContainer_MouseEnter"
                          MouseLeave="NavFixedAssetsContainer_MouseLeave">
                        <ToggleButton x:Name="NavFixedAssets"
                                      Style="{StaticResource TopNavItemStyle}"
                                      Checked="NavItem_Checked"
                                      Click="NavFixedAssets_Click"
                                      Tag="fixed-assets">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15"
                                         Height="15"
                                         Margin="0,0,7,0">
                                    <Canvas Width="24"
                                            Height="24">
                                        <Rectangle Canvas.Left="4"
                                                   Canvas.Top="4"
                                                   Width="16"
                                                   Height="16"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                   StrokeThickness="1.8"/>
                                        <Path Data="M4 10 H20 M10 4 V20"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              StrokeThickness="1.8"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Fixed Assets"
                                           VerticalAlignment="Center"/>
                                <Path Data="M0 3.5 L3.5 0 L7 3.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.6"
                                      Margin="6,1,0,0"
                                      VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Fixed Assets Dropdown Sub-menu -->
                        <Popup x:Name="FixedAssetsPopup"
                               PlacementTarget="{Binding ElementName=NavFixedAssets}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border x:Name="FixedAssetsPopupBorder"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,12,12"
                                    Padding="8,0,12,12"
                                    MinWidth="350"
                                    MouseEnter="FixedAssetsPopup_MouseEnter"
                                    MouseLeave="FixedAssetsPopup_MouseLeave">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.14"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Orange Accent Bar directly below active tab -->
                                    <Border Grid.Row="0" Background="#D9531E" Margin="-8,0,-12,0" HorizontalAlignment="Stretch"/>

                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <!-- Map Fixed Asset -->
                                        <Button x:Name="MenuMapFixedAsset"
                                                Click="MenuMapFixedAsset_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="14,10"
                                                HorizontalContentAlignment="Left"
                                                Cursor="Hand"
                                                Margin="0,0,0,3">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#FFF5EC"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Location Pin Icon -->
                                                <Path Grid.Column="0"
                                                      Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                                      Fill="{StaticResource SaffronDeepBrush}"
                                                      Width="18" Height="18" Stretch="Uniform" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Map Fixed Asset" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource InkBrush}"/>
                                                    <TextBlock Text="Rooms — map, edit and move assets" FontSize="11.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Fixed Asset Report -->
                                        <Button x:Name="MenuFixedAssetReport"
                                                Click="MenuFixedAssetReport_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="14,10"
                                                HorizontalContentAlignment="Left"
                                                Cursor="Hand"
                                                Margin="0,0,0,3">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#FFF5EC"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Trend / Analytics Chart Icon -->
                                                <Path Grid.Column="0"
                                                      Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"
                                                      Fill="{StaticResource SaffronDeepBrush}"
                                                      Width="18" Height="18" Stretch="Uniform" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Fixed Asset Report" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource InkBrush}"/>
                                                    <TextBlock Text="All assets, Karyalya / Vibhag / Item wise, export" FontSize="11.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Add Fixed Asset Purchase -->
                                        <Button x:Name="MenuAddFixedAssetPurchase"
                                                Click="MenuAddFixedAssetPurchase_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="14,10"
                                                HorizontalContentAlignment="Left"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#FFF5EC"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Shopping Cart Icon -->
                                                <Path Grid.Column="0"
                                                      Data="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"
                                                      Fill="{StaticResource SaffronDeepBrush}"
                                                      Width="18" Height="18" Stretch="Uniform" Margin="0,2,14,0" VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Add Fixed Asset Purchase" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource InkBrush}"/>
                                                    <TextBlock Text="Record a purchase of fixed-asset items" FontSize="11.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- NavStockReport -->
                    <ToggleButton x:Name="NavStockReport"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="stock-report">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M4 19 H20 M7 15 V11 M12 15 V7 M17 15 V7"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Stock Report"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavDamage -->
                    <ToggleButton x:Name="NavDamage"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="damage">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M10.29 3.86 L1.82 18 A2,2 0 0 0 3.53,21 H20.47 A2,2 0 0 0 22.18,18 L13.71 3.86 A2,2 0 0 0 10.29,3.86 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M12 9 V13 M12 17 L12.01 17"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Damage"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavRaisePo -->
                    <ToggleButton x:Name="NavRaisePo"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="raise-po">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M9 12 H15 M9 16 H15 M9 8 H10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M6 3 H15 L20 8 V21 A1,1 0 0 1 19,22 H6 A1,1 0 0 1 5,21 V4 A1,1 0 0 1 6,3 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Raise PO"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavAddPurchase -->
                    <ToggleButton x:Name="NavAddPurchase"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="add-purchase">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Ellipse Canvas.Left="7.6"
                                             Canvas.Top="18.6"
                                             Width="2.8"
                                             Height="2.8"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="1.8"/>
                                    <Ellipse Canvas.Left="15.6"
                                             Canvas.Top="18.6"
                                             Width="2.8"
                                             Height="2.8"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="1.8"/>
                                    <Path Data="M2 3 H4 L6.4 15.2 A2,2 0 0 0 8.4,16.8 H15.6 A2,2 0 0 0 17.6,15.2 L21 7 H6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Purchase"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavQuotation (NEW) -->
                    <ToggleButton x:Name="NavQuotation"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="quotation">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M14 2V8H20 M16 13H8 M16 17H8 M10 9H8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Quotation"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavAddDistribution -->
                    <ToggleButton x:Name="NavAddDistribution"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="add-export">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M12 3 V15 M7 8 L12 3 L17 8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M4 15 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V15"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Distribution"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavIssueBorrow -->
                    <ToggleButton x:Name="NavIssueBorrow"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="issue-borrow">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M6 3 H18 A1,1 0 0 1 19,4 V21 L12 17 L5 21 V4 A1,1 0 0 1 6,3 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Issue Goods"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavAddVendor -->
                    <ToggleButton x:Name="NavAddVendor"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="add-vendor">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Ellipse Canvas.Left="8.8"
                                             Canvas.Top="4.8"
                                             Width="6.4"
                                             Height="6.4"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             StrokeThickness="1.8"/>
                                    <Path Data="M5 20 C5 16.4 8 14 12 14 S19 16.4 19 20"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Vendor"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavCategory -->
                    <ToggleButton x:Name="NavCategory"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="category">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Rectangle Canvas.Left="3"
                                            Canvas.Top="3"
                                            Width="7"
                                            Height="7"
                                            RadiusX="1.2"
                                            RadiusY="1.2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                            StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="14"
                                            Canvas.Top="3"
                                            Width="7"
                                            Height="7"
                                            RadiusX="1.2"
                                            RadiusY="1.2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                            StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="3"
                                            Canvas.Top="14"
                                            Width="7"
                                            Height="7"
                                            RadiusX="1.2"
                                            RadiusY="1.2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                            StrokeThickness="1.8"/>
                                    <Rectangle Canvas.Left="14"
                                            Canvas.Top="14"
                                            Width="7"
                                            Height="7"
                                            RadiusX="1.2"
                                            RadiusY="1.2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                            StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Category"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavAddProduct -->
                    <ToggleButton x:Name="NavAddProduct"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="add-product">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M21 8 L12 3 L3 8 L12 13 L21 8 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M3 8 V16 L12 21 L21 16 V8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M12 13 V21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Add Product"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavUtilityExpenses (NEW) -->
                    <ToggleButton x:Name="NavUtilityExpenses"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="utility-expenses">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Utility Expenses"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavUtilityReminder (NEW) -->
                    <ToggleButton x:Name="NavUtilityReminder"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="utility-reminder">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M18 8A6 6 0 0 0 6 8C6 15 3 17 3 17H21S18 15 18 8 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                    <Path Data="M13.73 21A2 2 0 0 1 10.27 21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Utility Reminder"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- NavReports (NEW) -->
                    <ToggleButton x:Name="NavReports"
                                  Style="{StaticResource TopNavItemStyle}"
                                  Checked="NavItem_Checked"
                                  Tag="reports">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="0,0,7,0">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Reports"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ MAIN CONTENT AREA ============ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title Header -->
            <Border Grid.Row="0"
                    Padding="32,20,32,10">
                <TextBlock x:Name="PanelTitleText"
                           Text="Dashboard Overview"
                           FontFamily="{StaticResource HeadingFont}"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="{StaticResource InkBrush}"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- .dash-body -->
            <Grid Grid.Row="1"
                  Margin="32,10,32,32">
                <Grid>
                    <!-- Each panel is a placeholder for now — built out in its own phase -->
                    <!-- <Border x:Name="PanelFoodPackets" Style="{StaticResource PlaceholderPanel}" Padding="0" Visibility="Collapsed"> -->
                    <Border x:Name="PanelDashboard"
                            Style="{StaticResource PlaceholderPanel}"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Focusable="False">
                            <StackPanel>
                                <!-- Date Filter Card -->
                                <Border Background="White"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="20,16"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Title & Icon -->
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,24,0">
                                            <Border Width="34"
                                                    Height="34"
                                                    CornerRadius="8"
                                                    Background="#FFF5EC"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <Path Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"
                                                      Fill="{StaticResource SaffronDeepBrush}"
                                                      Stretch="Uniform"
                                                      Width="16"
                                                      Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Filter Overview"
                                                           FontFamily="{StaticResource HeadingFont}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource InkBrush}"/>
                                                <TextBlock Text="Format: dd/mm/yyyy"
                                                           FontSize="11"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Date Inputs & Clear Button -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="From Date"
                                                           Style="{StaticResource FieldLabel}"/>
                                                <DatePicker x:Name="DashDateFrom"
                                                            Width="165"
                                                            Language="en-IN"
                                                            FontFamily="{StaticResource BodyFont}"
                                                            FontSize="13"
                                                            SelectedDateChanged="DashDateChanged"
                                                            Style="{StaticResource RoundedDatePicker}"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="To Date"
                                                           Style="{StaticResource FieldLabel}"/>
                                                <DatePicker x:Name="DashDateTo"
                                                            Width="165"
                                                            Language="en-IN"
                                                            FontFamily="{StaticResource BodyFont}"
                                                            FontSize="13"
                                                            SelectedDateChanged="DashDateChanged"
                                                            Style="{StaticResource RoundedDatePicker}"/>
                                            </StackPanel>

                                            <Button Content="Clear Filters"
                                                    Style="{StaticResource OutlineButton}"
                                                    VerticalAlignment="Bottom"
                                                    Padding="14,5"
                                                    Height="36"
                                                    Click="ClearDashFiltersButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Stat cards -->
                                <UniformGrid Columns="4"
                                             Margin="0,0,0,16">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="VENDORS"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashVendorCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="PRODUCTS"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashProductCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="PURCHASE ORDERS"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashPoCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="PURCHASES (VALUE)"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashPurchaseValueText"
                                                       Text="₹0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource SaffronDeepBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="DISTRIBUTIONS"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashDistributionCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="DAMAGE REPORTS"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashDamageCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource ErrorBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="PENDING ISSUES"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashIssuePendingCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource SaffronDeepBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="OVERDUE ISSUES"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashIssueOverdueCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource ErrorBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="FIXED ASSETS VALUE"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashAssetsValueText"
                                                       Text="₹0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="STOCK ITEMS TRACKED"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashStockItemCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="OUT OF STOCK"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashOutOfStockCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource ErrorBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,14"
                                            Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="FOOD PACKET BATCHES"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DashBatchCountText"
                                                       Text="0"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="22"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Row: Low Stock + Pending/Overdue Issues -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock Text="Low Stock — Needs Attention"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{StaticResource InkBrush}"
                                                       Margin="18,16"/>
                                            <Border Height="1"
                                                    Background="{StaticResource LineBrush}"/>
                                            <DataGrid x:Name="DashLowStockGrid"
                                                      Style="{StaticResource AppDataGrid}"
                                                      MaxHeight="220"
                                                      IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Item"
                                                                        Binding="{Binding Item}"
                                                                        Width="1.6*"/>
                                                    <DataGridTextColumn Header="Remaining"
                                                                        Binding="{Binding RemainingDisplay}"
                                                                        Width="1*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="DashLowStockEmptyText"
                                                       Text="Nothing looks low right now."
                                                       Visibility="Collapsed"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock Text="Pending &amp; Overdue Issues"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{StaticResource InkBrush}"
                                                       Margin="18,16"/>
                                            <Border Height="1"
                                                    Background="{StaticResource LineBrush}"/>
                                            <DataGrid x:Name="DashPendingIssuesGrid"
                                                      Style="{StaticResource AppDataGrid}"
                                                      MaxHeight="220"
                                                      IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Event"
                                                                        Binding="{Binding EventName}"
                                                                        Width="1.3*"/>
                                                    <DataGridTextColumn Header="Item"
                                                                        Binding="{Binding Item}"
                                                                        Width="1*"/>
                                                    <DataGridTextColumn Header="Deposit Date"
                                                                        Binding="{Binding DepositDateDisplay}"
                                                                        Width="1*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="DashPendingIssuesEmptyText"
                                                       Text="Nothing pending — all caught up."
                                                       Visibility="Collapsed"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Row: Recent Purchase Orders + Recent Purchases -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock Text="Recent Purchase Orders"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{StaticResource InkBrush}"
                                                       Margin="18,16"/>
                                            <Border Height="1"
                                                    Background="{StaticResource LineBrush}"/>
                                            <DataGrid x:Name="DashRecentPoGrid"
                                                      Style="{StaticResource AppDataGrid}"
                                                      MaxHeight="220"
                                                      IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="PO Reference"
                                                                        Binding="{Binding PoReference}"
                                                                        Width="1.2*"/>
                                                    <DataGridTextColumn Header="Vendor"
                                                                        Binding="{Binding VendorName}"
                                                                        Width="1.3*"/>
                                                    <DataGridTextColumn Header="Date"
                                                                        Binding="{Binding CreatedDateDisplay}"
                                                                        Width="1*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="DashRecentPoEmptyText"
                                                       Text="No purchase orders yet."
                                                       Visibility="Collapsed"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="White"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock Text="Recent Purchases"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{StaticResource InkBrush}"
                                                       Margin="18,16"/>
                                            <Border Height="1"
                                                    Background="{StaticResource LineBrush}"/>
                                            <DataGrid x:Name="DashRecentPurchaseGrid"
                                                      Style="{StaticResource AppDataGrid}"
                                                      MaxHeight="220"
                                                      IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Vendor"
                                                                        Binding="{Binding VendorName}"
                                                                        Width="1.3*"/>
                                                    <DataGridTextColumn Header="Total"
                                                                        Binding="{Binding TotalDisplay}"
                                                                        Width="1*"/>
                                                    <DataGridTextColumn Header="Date"
                                                                        Binding="{Binding PurchaseDateDisplay}"
                                                                        Width="1*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="DashRecentPurchaseEmptyText"
                                                       Text="No purchases yet."
                                                       Visibility="Collapsed"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border x:Name="PanelFoodPackets"
                            Style="{StaticResource PlaceholderPanel}"
                            Padding="0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="22,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Recent Batches"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button Content="Ledger"
                                            Style="{StaticResource OutlineButton}"
                                            Margin="0,0,10,0"
                                            Click="LedgerButton_Click"/>
                                    <Button Content="+ New Batch"
                                            Style="{StaticResource MiniButton}"
                                            Click="NewBatchButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{StaticResource LineBrush}"/>

                            <DataGrid x:Name="BatchesGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource AppDataGrid}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Batch ID"
                                                        Binding="{Binding BatchCode}"
                                                        Width="0.9*"/>
                                    <DataGridTextColumn Header="Item"
                                                        Binding="{Binding ItemName}"
                                                        Width="1.3*"/>
                                    <DataGridTextColumn Header="Quantity"
                                                        Binding="{Binding QtyDisplay}"
                                                        Width="0.8*"/>
                                    <DataGridTextColumn Header="Dispatched"
                                                        Binding="{Binding DispatchedDisplay}"
                                                        Width="0.9*"/>
                                    <DataGridTextColumn Header="Remaining"
                                                        Binding="{Binding AvailableDisplay}"
                                                        Width="0.9*"/>
                                    <DataGridTextColumn Header="Vendor"
                                                        Binding="{Binding VendorDisplay}"
                                                        Width="1.1*"/>
                                    <DataGridTextColumn Header="Meeting / Campaign"
                                                        Binding="{Binding MeetingCampaignDisplay}"
                                                        Width="1.2*"/>
                                    <DataGridTemplateColumn Header="Actions"
                                                            Width="1.6*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding DispatchButtonText}"
                                                            IsEnabled="{Binding CanDispatch}"
                                                            Style="{StaticResource OutlineButton}"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Margin="0,0,6,0"
                                                            Click="DispatchButton_Click"/>
                                                    <Button Content="{Binding ViewDispatchesText}"
                                                            Style="{StaticResource OutlineButton}"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Click="ViewDispatchesButton_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border x:Name="PanelFixedAssets"
                            Style="{StaticResource PlaceholderPanel}"
                            Visibility="Collapsed"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Breadcrumbs & Description -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Map Fixed Asset" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="20" Foreground="{StaticResource InkBrush}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,4">
                                    <Run Text="Inventory / " Foreground="{StaticResource InkSoftBrush}"/>
                                    <Run Text="Fixed Assets / Map Fixed Asset" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                                </TextBlock>
                                <TextBlock Text="Every room with fixed assets mapped to it. Use Edit Room to add, replace or move a room's assets in one go."
                                           FontSize="13" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Rooms Card -->
                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header: Title, Search, + Map Fixed Asset Button -->
                                    <Grid Grid.Row="0" Margin="22,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Rooms" FontFamily="{StaticResource HeadingFont}"
                                                   FontWeight="Bold" FontSize="16.5" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Compact Search Box -->
                                            <Border Width="240" Height="36" Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1.5" CornerRadius="8" Padding="10,0" Margin="0,0,12,0">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="M10 17 A7 7 0 1 1 17 10 A7 7 0 0 1 10 17 Z M15 15 L20 20"
                                                          Stroke="{StaticResource InkSoftBrush}" StrokeThickness="1.6" Width="13" Height="13"
                                                          Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Grid Grid.Column="1">
                                                        <TextBlock Text="Search rooms, items, codes..."
                                                                   Visibility="{Binding Text, ElementName=RoomsSearchBox, Converter={StaticResource StringToVisibilityConverter}}"
                                                                   Foreground="{StaticResource InkSoftBrush}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                        <TextBox x:Name="RoomsSearchBox" Background="Transparent" BorderThickness="0"
                                                                 FontSize="12.5" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"
                                                                 Padding="0" TextChanged="RoomsSearchBox_TextChanged"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Button Content="+ Map Fixed Asset" Style="{StaticResource MiniButton}" Padding="18,0" Height="36"
                                                    FontSize="12.5" Click="MapFixedAssetButton_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Height="1" Background="{StaticResource LineBrush}"/>

                                    <!-- Rooms DataGrid -->
                                    <DataGrid x:Name="RoomsGrid" Grid.Row="2" Style="{StaticResource AppDataGrid}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="KARYALYA" Binding="{Binding Karyalya}" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="140" Width="1.2*"/>
                                            <DataGridTextColumn Header="DEPARTMENT / VIBHAG" Binding="{Binding Department}" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="150" Width="1.3*"/>
                                            <DataGridTextColumn Header="ROOM NO." Binding="{Binding RoomNoDisplay}" FontWeight="Bold" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="100" Width="1*"/>
                                            <DataGridTextColumn Header="TOTAL ASSETS" Binding="{Binding TotalAssetsDisplay}" FontWeight="Bold" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="95" Width="0.9*"/>
                                            <DataGridTemplateColumn Header="ACTIVE" MinWidth="75" Width="0.8*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ActiveCountDisplay}" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="DAMAGED" Binding="{Binding DamagedCountDisplay}" FontWeight="Bold" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="80" Width="0.8*"/>
                                            <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemsSummary}" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="180" Width="2*"/>
                                            <DataGridTemplateColumn Header="ACTIONS" MinWidth="220" Width="230">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Edit Room" Style="{StaticResource OutlineButton}" Height="30" Padding="12,0" FontSize="12" Margin="0,0,8,0" Click="EditRoomButton_Click"/>
                                                            <Button Content="View Assets" Style="{StaticResource OutlineButton}" Height="30" Padding="12,0" FontSize="12" Click="ViewRoomAssetsButton_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- PanelFixedAssetReport -->
                    <Border x:Name="PanelFixedAssetReport"
                            Style="{StaticResource PlaceholderPanel}"
                            Visibility="Collapsed"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Breadcrumbs & Description -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock FontSize="12.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,5">
                                    <Run Text="Inventory / " Foreground="{StaticResource InkSoftBrush}"/>
                                    <Run Text="Fixed Assets / " FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                                    <Run Text="Fixed Asset Report" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                                </TextBlock>
                                <TextBlock Text="All mapped fixed assets — view them one by one or grouped by Karyalya, Department / Vibhag or Item, and export to Excel."
                                           FontSize="13" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Main Card -->
                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header: Title + Search Box + Export to Excel -->
                                    <Grid Grid.Row="0" Margin="22,18,22,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Fixed Asset Report" FontFamily="{StaticResource HeadingFont}"
                                                   FontWeight="Bold" FontSize="16.5" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Search Box with Icon & Placeholder -->
                                            <Border Width="260" Height="36" Background="#FFFCF9" BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1.5" CornerRadius="8" Padding="10,0" Margin="0,0,12,0">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="M10 17 A7 7 0 1 1 17 10 A7 7 0 0 1 10 17 Z M15 15 L20 20"
                                                          Stroke="{StaticResource InkSoftBrush}" StrokeThickness="1.6" Width="13" Height="13"
                                                          Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Grid Grid.Column="1">
                                                        <TextBlock x:Name="FixedAssetReportSearchPlaceholder"
                                                                   Text="Search by unique code, item, room..."
                                                                   Visibility="{Binding Text, ElementName=FixedAssetReportSearchBox, Converter={StaticResource StringToVisibilityConverter}}"
                                                                   Foreground="{StaticResource InkSoftBrush}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                        <TextBox x:Name="FixedAssetReportSearchBox" Background="Transparent" BorderThickness="0"
                                                                 FontSize="12.5" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center"
                                                                 Padding="0" TextChanged="FixedAssetReportSearchBox_TextChanged"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Button Content="Export to Excel" Style="{StaticResource OutlineButton}" Padding="16,0" Height="36"
                                                    FontSize="12.5" Click="ExportFixedAssetReportButton_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Pill Tabs with Counts -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,0,22,14">
                                        <!-- All Assets Tab -->
                                        <Button x:Name="BtnTabAllAssets" Click="TabAllAssets_Click" Cursor="Hand" Margin="0,0,10,0"
                                                Background="#EA580C" BorderThickness="0" Padding="14,6">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtTabAllAssets" Text="All Assets" FontWeight="SemiBold" FontSize="12.5" Foreground="White" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeTabAllAssets" Background="#C2410C" CornerRadius="10" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CountTabAllAssets" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Karyalya Wise Tab -->
                                        <Button x:Name="BtnTabKaryalyaWise" Click="TabKaryalyaWise_Click" Cursor="Hand" Margin="0,0,10,0"
                                                Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,6">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtTabKaryalyaWise" Text="Karyalya Wise" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeTabKaryalyaWise" Background="#FFEDD5" CornerRadius="10" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CountTabKaryalyaWise" Text="0" Foreground="#C2410C" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Department / Vibhag Wise Tab -->
                                        <Button x:Name="BtnTabDepartmentWise" Click="TabDepartmentWise_Click" Cursor="Hand" Margin="0,0,10,0"
                                                Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,6">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtTabDepartmentWise" Text="Department / Vibhag Wise" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeTabDepartmentWise" Background="#FFEDD5" CornerRadius="10" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CountTabDepartmentWise" Text="0" Foreground="#C2410C" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Item Wise Tab -->
                                        <Button x:Name="BtnTabItemWise" Click="TabItemWise_Click" Cursor="Hand" Margin="0,0,10,0"
                                                Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,6">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtTabItemWise" Text="Item Wise" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeTabItemWise" Background="#FFEDD5" CornerRadius="10" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CountTabItemWise" Text="0" Foreground="#C2410C" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Room Filter Banner & Divider -->
                                    <StackPanel Grid.Row="2">
                                        <Border x:Name="RoomFilterBanner"
                                                Background="#FFF6EE"
                                                BorderBrush="#FFEAD8"
                                                BorderThickness="0,1,0,1"
                                                Padding="22,10"
                                                Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock VerticalAlignment="Center" FontSize="13">
                                                    <Run Text="Showing assets for " Foreground="{StaticResource InkSoftBrush}"/>
                                                    <Run x:Name="RoomFilterLabelText" Text="Room No. 12, Adhyaksh Karyalya (Pradesh Karyalya)" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                                </TextBlock>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="EditFilteredRoomButton"
                                                            Content="Edit Room"
                                                            Style="{StaticResource MiniButton}"
                                                            Height="30"
                                                            Padding="14,0"
                                                            FontSize="12"
                                                            Margin="0,0,8,0"
                                                            Click="EditFilteredRoomButton_Click"/>

                                                    <Button x:Name="ClearFilteredRoomButton"
                                                            Content="✕ Clear"
                                                            Style="{StaticResource OutlineButton}"
                                                            Height="30"
                                                            Padding="14,0"
                                                            FontSize="12"
                                                            Click="ClearFilteredRoomButton_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Background="{StaticResource LineBrush}"/>
                                    </StackPanel>

                                    <!-- Content Grids Area -->
                                    <Grid Grid.Row="3">
                                        <!-- 1. All Assets Grid -->
                                        <DataGrid x:Name="ReportAllAssetsGrid" Style="{StaticResource AppDataGrid}" Visibility="Visible"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="UNIQUE CODE" MinWidth="135" Width="1.1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemUniqueCode}" FontFamily="Consolas, Segoe UI Mono, monospace" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource InkBrush}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="ITEM" Binding="{Binding ItemName}" FontWeight="SemiBold" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="130" Width="1.2*"/>
                                                <DataGridTextColumn Header="ITEM CODE" Binding="{Binding ProductCode}" Foreground="#64748B" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="105" Width="1*"/>
                                                <DataGridTextColumn Header="KARYALYA" Binding="{Binding KaryalyaName}" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="130" Width="1.2*"/>
                                                <DataGridTextColumn Header="DEPARTMENT / VIBHAG" Binding="{Binding DepartmentName}" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="140" Width="1.3*"/>
                                                <DataGridTextColumn Header="ROOM NO." Binding="{Binding RoomNoDisplay}" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="105" Width="1*"/>
                                                <DataGridTextColumn Header="MAPPED ON" Binding="{Binding MappedOnDisplay}" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="100" Width="0.9*"/>
                                                <DataGridTemplateColumn Header="STATUS" MinWidth="90" Width="0.9*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActiveStatus}" Value="False">
                                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11.5">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActiveStatus}" Value="False">
                                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="LAST UPDATED" Binding="{Binding LastUpdatedDisplay}" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="100" Width="0.9*"/>
                                                <DataGridTemplateColumn Header="ACTIONS" MinWidth="320" Width="330">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- <Button Content="Edit" Style="{StaticResource OutlineButton}" Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,4,0" Click="ReportEditItemButton_Click"/> -->
                                                                <Button Content="Move" Style="{StaticResource OutlineButton}" Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,4,0" Click="ReportMoveItemButton_Click"/>
                                                                <Button Content="Mark Damaged" Style="{StaticResource OutlineButton}" Height="28" Padding="8,0" FontSize="11.5" Margin="0,0,4,0"
                                                                        Visibility="{Binding IsActiveStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        Click="ReportMarkDamagedButton_Click"/>
                                                                <Button Content="History" Style="{StaticResource OutlineButton}" Height="28" Padding="10,0" FontSize="11.5" Click="ReportHistoryButton_Click"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- 2. Karyalya Wise Grid -->
                                        <DataGrid x:Name="ReportKaryalyaGrid" Style="{StaticResource AppDataGrid}" Visibility="Collapsed"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="KARYALYA" Binding="{Binding KaryalyaName}" FontWeight="Bold" ElementStyle="{StaticResource WrapTextCellStyle}" MinWidth="150" Width="1.4*"/>
