                                        <DataGridTextColumn Header="PROJECT NAME"
                                                            Binding="{Binding ProjectName}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="180"
                                                            Width="1.8*"/>

                                        <DataGridTextColumn Header="CLIENT / DEPARTMENT"
                                                            Binding="{Binding ClientDepartment}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="160"
                                                            Width="1.6*"/>

                                        <DataGridTextColumn Header="CATEGORY"
                                                            Binding="{Binding Category}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="120"
                                                            Width="1.2*"/>

                                        <DataGridTextColumn Header="QUOTATIONS"
                                                            Binding="{Binding QuotationCount}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="100"
                                                            Width="1*"/>

                                        <DataGridTextColumn Header="LOWEST QUOTE"
                                                            Binding="{Binding LowestQuoteDisplay}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="130"
                                                            Width="1.3*"/>

                                        <!-- Status Pill Badge -->
                                        <DataGridTemplateColumn Header="STATUS"
                                                                MinWidth="100"
                                                                Width="1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusBgBrush}"
                                                            CornerRadius="10"
                                                            Padding="10,3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="{Binding StatusFgBrush}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11.5"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="DATE CREATED"
                                                            Binding="{Binding DateCreatedDisplay}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="120"
                                                            Width="1.2*"/>

                                        <!-- Action Buttons: View, Edit, Delete -->
                                        <DataGridTemplateColumn Header="ACTIONS"
                                                                MinWidth="210"
                                                                Width="2.1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="View"
                                                                Style="{StaticResource OutlineButton}"
                                                                Padding="12,4"
                                                                FontSize="12"
                                                                Margin="0,0,6,0"
                                                                Click="ViewProjectButton_Click"
                                                                Tag="{Binding Id}"/>

                                                        <Button Content="Edit"
                                                                Style="{StaticResource OutlineButton}"
                                                                Padding="12,4"
                                                                FontSize="12"
                                                                Margin="0,0,6,0"
                                                                Click="EditProjectButton_Click"
                                                                Tag="{Binding Id}"/>

                                                        <Button Content="Delete"
                                                                Style="{StaticResource OutlineButton}"
                                                                Padding="12,4"
                                                                FontSize="12"
                                                                Click="DeleteProjectButton_Click"
                                                                Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- ============ UTILITY EXPENSES PANEL ============ -->
                    <Border x:Name="PanelUtilityExpenses"
                            Style="{StaticResource PlaceholderPanel}"
                            Padding="0"
                            Visibility="Collapsed"
                            BorderThickness="0"
                            Background="Transparent">
                        <!-- Main Utility Expenses Card -->
                        <Border Background="White"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header & Controls -->
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="0"
                                               Text="Utility Expenses"
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontWeight="Bold"
                                               FontSize="16.5"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Controls: Search & + Create Utility Expense -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Search Box Container -->
                                        <Border Background="#FFFCF9"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="10"
                                                Width="230"
                                                Height="38"
                                                Margin="0,0,12,0"
                                                Padding="10,0">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0"
                                                      Data="M10 17 A7 7 0 1 1 17 10 A7 7 0 0 1 10 17 Z M15 15 L20 20"
                                                      Stroke="{StaticResource InkSoftBrush}"
                                                      StrokeThickness="1.6"
                                                      Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      Margin="2,0,8,0"
                                                      VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1">
                                                    <TextBlock Text="Search location, bill no..."
                                                               Visibility="{Binding Text, ElementName=UtilityExpensesSearchBox, Converter={StaticResource StringToVisibilityConverter}}"
                                                               Foreground="{StaticResource InkSoftBrush}"
                                                               FontSize="12.5"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"/>
                                                    <TextBox x:Name="UtilityExpensesSearchBox"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             FontSize="12.5"
                                                             Foreground="{StaticResource InkBrush}"
                                                             VerticalContentAlignment="Center"
                                                             Padding="0"
                                                             TextChanged="UtilityExpensesSearchBox_TextChanged"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Add Button -->
                                        <Button Content="+ Create Utility Expense"
                                                Style="{StaticResource MiniButton}"
                                                Height="38"
                                                Padding="16,0"
                                                Click="AddUtilityExpenseButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Row="1"
                                        Background="{StaticResource LineBrush}"/>

                                <!-- DataGrid Table -->
                                <Grid Grid.Row="2"
                                      Margin="0,14,0,0">
                                    <DataGrid x:Name="UtilityExpensesGrid"
                                              Style="{StaticResource AppDataGrid}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              MaxHeight="560">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Category"
                                                                Binding="{Binding CategoryDisplay}"
                                                                Width="1.1*"/>
                                            <DataGridTextColumn Header="Location"
                                                                Binding="{Binding LocationDisplay}"
                                                                Width="1.6*"/>
                                            <DataGridTextColumn Header="Expense Date"
                                                                Binding="{Binding ExpenseDateDisplay}"
                                                                Width="1.1*"/>
                                            <DataGridTextColumn Header="Amount"
                                                                Binding="{Binding AmountDisplay}"
                                                                Width="1*"/>
                                            <DataGridTextColumn Header="Bill No"
                                                                Binding="{Binding BillNoDisplay}"
                                                                Width="1.1*"/>
                                            <DataGridTextColumn Header="Description"
                                                                Binding="{Binding DescriptionDisplay}"
                                                                Width="1.8*"/>
                                            <DataGridTextColumn Header="Created At"
                                                                Binding="{Binding CreatedAtDisplay}"
                                                                Width="1.2*"/>
                                            <DataGridTemplateColumn Header="Actions"
                                                                    Width="1.8*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="{Binding BillImageButtonText}"
                                                                    IsEnabled="{Binding HasBillImage}"
                                                                    Style="{StaticResource OutlineButton}"
                                                                    Padding="10,4"
                                                                    Margin="0,0,8,0"
                                                                    FontSize="12"
                                                                    Click="ViewBillImageButton_Click"/>
                                                            <Button Content="Delete"
                                                                    Style="{StaticResource OutlineButton}"
                                                                    Padding="10,4"
                                                                    FontSize="12"
                                                                    Foreground="{StaticResource ErrorBrush}"
                                                                    Click="DeleteUtilityExpenseButton_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Empty Text -->
                                    <TextBlock x:Name="UtilityExpensesEmptyText"
                                               Text="No utility expenses logged yet. Click '+ Create Utility Expense' above to add one."
                                               Visibility="Collapsed"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               FontSize="13.5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,40"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- ============ UTILITY REMINDER PANEL ============ -->
                    <Border x:Name="PanelUtilityReminder"
                            Style="{StaticResource PlaceholderPanel}"
                            Padding="0"
                            Visibility="Collapsed"
                            BorderThickness="0"
                            Background="Transparent">
                        <!-- Main Utility Reminders Card -->
                        <Border Background="White"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header & Controls -->
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="0"
                                               Text="Utility Reminders"
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontWeight="Bold"
                                               FontSize="16.5"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Controls: Search & + Create Reminder -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Search Box Container with Magnifying Glass Icon -->
                                        <Border Background="#FFFCF9"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="10"
                                                Width="230"
                                                Height="38"
                                                Margin="0,0,12,0"
                                                Padding="10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Search Icon -->
                                                <Path Grid.Column="0"
                                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                                      Fill="{StaticResource InkSoftBrush}"
                                                      Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>

                                                <!-- Search Input -->
                                                <TextBox x:Name="SearchRemindersBox"
                                                         Grid.Column="1"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="13"
                                                         Foreground="{StaticResource InkBrush}"
                                                         CaretBrush="{StaticResource InkBrush}"
                                                         VerticalContentAlignment="Center"
                                                         Tag="Search reminders..."
                                                         TextChanged="SearchRemindersBox_TextChanged">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <Grid>
                                                                            <TextBlock x:Name="PlaceholderText"
                                                                                       Text="{TemplateBinding Tag}"
                                                                                       Foreground="{StaticResource InkSoftBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="{TemplateBinding FontSize}"
                                                                                       IsHitTestVisible="False"
                                                                                       Opacity="0.65"
                                                                                       Visibility="Collapsed"/>
                                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                                          VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="Text"
                                                                                     Value="">
                                                                                <Setter TargetName="PlaceholderText"
                                                                                        Property="Visibility"
                                                                                        Value="Visible"/>
                                                                            </Trigger>
                                                                            <Trigger Property="Text"
                                                                                     Value="{x:Null}">
                                                                                <Setter TargetName="PlaceholderText"
                                                                                        Property="Visibility"
                                                                                        Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </Border>

                                        <!-- Create Reminder Button -->
                                        <Button Content="+ Create Reminder"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="18,0"
                                                Height="38"
                                                FontSize="12.5"
                                                Click="CreateReminderButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Row="1"
                                        Background="{StaticResource LineBrush}"
                                        Margin="0,0,0,16"/>

                                <!-- Utility Reminders DataGrid -->
                                <DataGrid x:Name="RemindersGrid"
                                          Grid.Row="2"
                                          Style="{StaticResource AppDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="UTILITY"
                                                            Binding="{Binding UtilityName}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="150"
                                                            Width="1.5*"/>

                                        <DataGridTextColumn Header="DUE DATE (MONTHLY)"
                                                            Binding="{Binding DueDayDisplay}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="160"
                                                            Width="1.6*"/>

                                        <DataGridTextColumn Header="REMIND BEFORE"
                                                            Binding="{Binding RemindBeforeDisplay}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="160"
                                                            Width="1.6*"/>

                                        <DataGridTextColumn Header="NEXT REMINDER"
                                                            Binding="{Binding NextReminderDisplay}"
                                                            ElementStyle="{StaticResource WrapTextCellStyle}"
                                                            MinWidth="180"
                                                            Width="1.8*"/>

                                        <!-- Status Pill Badge -->
                                        <DataGridTemplateColumn Header="STATUS"
                                                                MinWidth="110"
                                                                Width="1.1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusBgBrush}"
                                                            CornerRadius="10"
                                                            Padding="10,3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="{Binding StatusFgBrush}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11.5"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Action Buttons: Edit, Delete -->
                                        <DataGridTemplateColumn Header="ACTIONS"
                                                                MinWidth="140"
                                                                Width="1.4*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="Edit"
                                                                Style="{StaticResource OutlineButton}"
                                                                Padding="14,4"
                                                                FontSize="12"
                                                                Margin="0,0,6,0"
                                                                Click="EditReminderButton_Click"
                                                                Tag="{Binding Id}"/>

                                                        <Button Content="Delete"
                                                                Style="{StaticResource OutlineButton}"
                                                                Padding="14,4"
                                                                FontSize="12"
                                                                Foreground="{StaticResource ErrorBrush}"
                                                                Click="DeleteReminderButton_Click"
                                                                Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- PanelReports (NEW) -->
                    <Border x:Name="PanelReports"
                            Style="{StaticResource PlaceholderPanel}"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Visibility="Collapsed">
                        <reports:ReportsMainView x:Name="ReportsViewControl"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- MOVE ASSET MODAL OVERLAY -->
        <!-- ======================================================== -->
        <Grid x:Name="MoveAssetModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="10000"
              Background="#77000000"
              Visibility="Collapsed"
              MouseDown="ModalOverlay_MouseDown">
            <Border Background="White"
                    CornerRadius="16"
                    Width="530"
                    MaxWidth="570"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    MouseDown="ModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3.5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Tricolor Accent Line -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#FF9933"/>
                        <Rectangle Grid.Column="1" Fill="White"/>
                        <Rectangle Grid.Column="2" Fill="#138808"/>
                    </Grid>

                    <!-- Row 1: Header -->
                    <Border Grid.Row="1" Background="White" Padding="24,16,20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Themed Icon Badge -->
                                <Border Width="38" Height="38" CornerRadius="10" Background="#FFF5EC" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="M10 9h4V6h3l-5-5-5 5h3v3zm-1 1H6V7l-5 5 5 5v-3h3v-4zm14 2l-5-5v3h-3v4h3v3l5-5zm-9 3h-4v3H7l5 5 5-5h-3v-3z"
                                          Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Move Asset" FontFamily="{StaticResource HeadingFont}"
                                               FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock x:Name="MoveModalSubtitle"
                                               Text="PK-MV-TBL-002 · Office Table — currently at Pradesh Karyalya > Media Vibhag, Room No. 46"
                                               FontSize="12" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Themed Category Pill -->
                                <Border Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="9,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Relocate Asset" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                                </Border>

                                <!-- Close Button [X] -->
                                <Button Content="✕" Style="{StaticResource WindowControlButton}" Width="28" Height="28"
                                        Click="CloseMoveModal_Click" ToolTip="Close"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Header Divider -->
                    <Border Grid.Row="2" Height="1" Background="{StaticResource LineBrush}"/>

                    <!-- Row 3: Form Body -->
                    <ScrollViewer Grid.Row="3" MaxHeight="440" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,14">
                            <!-- 1. New Karyalya -->
                            <TextBlock Text="1. New Karyalya" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="MoveKaryalyaCombo"
                                      Style="{StaticResource RoundedComboBox}"
                                      Tag="Select Karyalya"
                                      Height="38"
                                      SelectionChanged="MoveKaryalyaCombo_SelectionChanged"
                                      Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Id}" Value="-999">
                                                            <Setter Property="Foreground" Value="{StaticResource SaffronDeepBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 2. New Department / Vibhag -->
                            <TextBlock Text="2. New Department / Vibhag" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <ComboBox x:Name="MoveDepartmentCombo"
                                      Style="{StaticResource RoundedComboBox}"
                                      Tag="Select Karyalya first"
                                      Height="38"
                                      SelectionChanged="MoveDepartmentCombo_SelectionChanged"
                                      Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Id}" Value="-999">
                                                            <Setter Property="Foreground" Value="{StaticResource SaffronDeepBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 3. New Room No. (optional) -->
                            <TextBlock Text="3. New Room No. (optional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <TextBox x:Name="MoveRoomNoBox"
                                     Style="{StaticResource RoundedTextBox}"
                                     Tag="e.g. Room No. 48"
                                     Height="38"/>

                            <!-- Move Date -->
                            <TextBlock Text="Move Date" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <DatePicker x:Name="MoveDatePicker"
                                        Style="{StaticResource RoundedDatePicker}"
                                        Height="38"/>

                            <!-- Remarks (optional) -->
                            <TextBlock Text="Remarks (optional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <TextBox x:Name="MoveRemarksBox"
                                     Style="{StaticResource RoundedTextBox}"
                                     Tag="e.g. Relocated during office renovation"
                                     Height="38"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 4: Footer Divider -->
                    <Border Grid.Row="4" Height="1" Background="{StaticResource LineBrush}"/>

                    <!-- Row 5: Footer Actions -->
                    <Border Grid.Row="5" Background="#FFFCF9" Padding="24,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Click="CloseMoveModal_Click"
                                    Style="{StaticResource OutlineButton}"
                                    Height="36"
                                    Padding="18,0"
                                    Margin="0,0,10,0"/>

                            <Button Content="Save Move"
                                    Click="SaveMoveButton_Click"
                                    Style="{StaticResource MiniButton}"
                                    Height="36"
                                    Padding="22,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ASSET HISTORY MODAL OVERLAY -->
        <!-- ======================================================== -->
        <Grid x:Name="AssetHistoryModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="10000"
              Background="#77000000"
              Visibility="Collapsed"
              MouseDown="ModalOverlay_MouseDown">
            <Border Background="White"
                    CornerRadius="16"
                    Width="540"
                    MaxWidth="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    MouseDown="ModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3.5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Tricolor Accent Line -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#FF9933"/>
                        <Rectangle Grid.Column="1" Fill="White"/>
                        <Rectangle Grid.Column="2" Fill="#138808"/>
                    </Grid>

                    <!-- Row 1: Header -->
                    <Border Grid.Row="1" Background="White" Padding="24,16,20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Themed Icon Badge -->
                                <Border Width="38" Height="38" CornerRadius="10" Background="#FFF5EC" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"
                                          Fill="{StaticResource SaffronDeepBrush}" Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="HistoryModalTitle"
                                               Text="PK-MV-CHR-002 · Executive Chair (CHR-EXE-01)"
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock Text="Full location and status trail for this asset."
                                               FontSize="12" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Themed Category Pill -->
                                <Border Background="#FFF5EC" BorderBrush="#F0D5C0" BorderThickness="1" CornerRadius="6" Padding="9,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Activity Trail" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SaffronDeepBrush}"/>
                                </Border>

                                <!-- Close Button [X] -->
                                <Button Content="✕" Style="{StaticResource WindowControlButton}" Width="28" Height="28"
                                        Click="CloseHistoryModal_Click" ToolTip="Close"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Header Divider -->
                    <Border Grid.Row="2" Height="1" Background="{StaticResource LineBrush}"/>

                    <!-- Row 3: Trail of Events List -->
                    <ScrollViewer Grid.Row="3" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,12,24,14">
                            <ItemsControl x:Name="HistoryItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding TitleDisplay}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{StaticResource InkBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding RemarksDisplay}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource InkSoftBrush}"
                                                               Margin="0,3,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasRemarks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DateDisplay}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           VerticalAlignment="Top"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="HistoryEmptyText"
                                       Text="No history records found for this asset."
                                       FontSize="13"
                                       Foreground="{StaticResource InkSoftBrush}"
                                       Margin="0,18"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 4: Footer Divider -->
                    <Border Grid.Row="4" Height="1" Background="{StaticResource LineBrush}"/>

                    <!-- Row 5: Footer Actions -->
                    <Border Grid.Row="5" Background="#FFFCF9" Padding="24,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Close"
                                    Click="CloseHistoryModal_Click"
                                    Style="{StaticResource MiniButton}"
                                    Height="36"
                                    Padding="24,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MARK ASSET DAMAGED MODAL OVERLAY -->
        <!-- ======================================================== -->
        <Grid x:Name="MarkDamagedModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="10000"
              Background="#77000000"
              Visibility="Collapsed"
              MouseDown="ModalOverlay_MouseDown">
            <Border Background="White"
                    CornerRadius="16"
                    Width="530"
                    MaxWidth="570"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    MouseDown="ModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3.5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Tricolor Accent Line -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#FF9933"/>
                        <Rectangle Grid.Column="1" Fill="White"/>
                        <Rectangle Grid.Column="2" Fill="#138808"/>
                    </Grid>

                    <!-- Row 1: Header -->
                    <Border Grid.Row="1" Background="White" Padding="24,16,20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Themed Icon Badge (Error/Damage) -->
                                <Border Width="38" Height="38" CornerRadius="10" Background="#FEE2E2" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                          Fill="{StaticResource ErrorBrush}" Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mark Asset Damaged" FontFamily="{StaticResource HeadingFont}"
                                               FontWeight="Bold" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock x:Name="MarkDamagedSubtitle"
                                               Text="PK-MV-CHR-001 · Executive Chair — at Pradesh Karyalya > Media Vibhag, Room No. 46"
                                               FontSize="12" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Themed Category Pill -->
                                <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="9,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Report Damage" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                                </Border>

                                <!-- Close Button [X] -->
                                <Button Content="✕" Style="{StaticResource WindowControlButton}" Width="28" Height="28"
                                        Click="CloseMarkDamagedModal_Click" ToolTip="Close"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Header Divider -->
                    <Border Grid.Row="2" Height="1" Background="{StaticResource LineBrush}"/>

                    <!-- Row 3: Body Form -->
                    <ScrollViewer Grid.Row="3" MaxHeight="430" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,14">
                            <!-- Damage Date -->
                            <TextBlock Text="Damage Date" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DamageDatePicker"
                                        Style="{StaticResource RoundedDatePicker}"
                                        Height="38"/>

                            <!-- DAMAGE PHOTOS -->
                            <TextBlock Text="DAMAGE PHOTOS"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="{StaticResource SaffronDeepBrush}"
                                       Margin="0,14,0,6"/>
                            <Border x:Name="DamageImageUploadBorder"
                                    BorderBrush="#F0D5C0"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Background="#FFFDF9"
                                    Padding="14,14"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="UploadDamagePhotos_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"
                                          Fill="{StaticResource SaffronDeepBrush}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,6"/>
                                    <TextBlock x:Name="DamagePhotoUploadText"
                                               Text="Click to upload damage photos — multiple allowed"
                                               FontSize="12"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Attached photos strip / count indicator -->
                            <Border x:Name="DamagePhotosListContainer"
                                    Visibility="Collapsed"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DamagePhotosCountText"
                                               Text="0 photo(s) selected"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="+ Add More"
                                                Click="UploadDamagePhotos_Click"
                                                Style="{StaticResource LinkButton}"
                                                FontSize="11.5"
                                                Foreground="{StaticResource SaffronDeepBrush}"
                                                Margin="0,0,10,0"/>
                                        <Button Content="Clear"
                                                Click="ClearDamagePhotos_Click"
                                                Style="{StaticResource LinkButton}"
                                                FontSize="11.5"
                                                Foreground="{StaticResource ErrorBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- REPORTEE DETAILS -->
                            <TextBlock Text="REPORTEE DETAILS"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="{StaticResource SaffronDeepBrush}"
                                       Margin="0,16,0,8"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Reportee Name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,6">
                                        <Run Text="Reportee Name " FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkBrush}"/>
                                        <Run Text="*" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <TextBox x:Name="DamageReporteeNameBox"
                                             Style="{StaticResource RoundedTextBox}"
                                             Tag="e.g. Ramesh Kumar"
                                             Height="38"/>
                                </StackPanel>

                                <!-- Reportee Number -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6">
                                        <Run Text="Reportee Number " FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkBrush}"/>
                                        <Run Text="*" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                                    </TextBlock>
                                    <TextBox x:Name="DamageReporteeNumberBox"
                                             Style="{StaticResource RoundedTextBox}"
                                             Tag="e.g. 98XXXXXXXX"
                                             Height="38"/>
                                </StackPanel>
                            </Grid>

                            <!-- Reportee Position -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,6">
                                    <Run Text="Reportee Position " FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkBrush}"/>
                                    <Run Text="*" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                                </TextBlock>
                                <TextBox x:Name="DamageReporteePositionBox"
                                         Style="{StaticResource RoundedTextBox}"
                                         Tag="e.g. Booth Convenor"
                                         Height="38"/>
                            </StackPanel>

                            <!-- Remark (optional) -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Remark (optional)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <TextBox x:Name="DamageRemarkBox"
                                         Style="{StaticResource RoundedTextBox}"
                                         Tag="Describe the damage..."
                                         Height="62"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Help / Sync Note -->
                            <TextBlock Text="This also creates an entry on the Damage page, so it shows up in damage reporting alongside everything else."
                                       FontSize="11.5"
                                       Foreground="{StaticResource InkSoftBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 4: Footer Divider -->
                    <Border Grid.Row="4" Height="1" Background="{StaticResource LineBrush}"/>

                    <!-- Row 5: Footer Actions -->
                    <Border Grid.Row="5" Background="#FFFCF9" Padding="24,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Click="CloseMarkDamagedModal_Click"
                                    Style="{StaticResource OutlineButton}"
                                    Height="36"
                                    Padding="18,0"
                                    Margin="0,0,10,0"/>

                            <Button Content="Submit"
                                    Click="SubmitMarkDamaged_Click"
                                    Style="{StaticResource MiniButton}"
                                    Height="36"
                                    Padding="22,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>