                                                            Click="DistributionReceiptButton_Click"/>
                                                    <Button Content="Edit"
                                                            Style="{StaticResource OutlineButton}"
                                                            Padding="10,6"
                                                            FontSize="12"
                                                            Click="EditDistributionButton_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border x:Name="PanelAddVendor"
                            Style="{StaticResource PlaceholderPanel}"
                            Visibility="Collapsed"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="22,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Vendors"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <!-- Compact Search Box with Icon & Placeholder -->
                                    <Border Width="180"
                                            Height="34"
                                            Background="#FFFCF9"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="8,0"
                                            Margin="0,0,10,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Search Icon -->
                                            <Path Grid.Column="0"
                                                  Data="M10 17 A7 7 0 1 1 17 10 A7 7 0 0 1 10 17 Z M15 15 L20 20"
                                                  Stroke="{StaticResource InkSoftBrush}"
                                                  StrokeThickness="1.6"
                                                  Width="13"
                                                  Height="13"
                                                  Stretch="Uniform"
                                                  Margin="2,0,6,0"
                                                  VerticalAlignment="Center"/>

                                            <Grid Grid.Column="1">
                                                <!-- Placeholder Text -->
                                                <TextBlock x:Name="VendorPlaceholderText"
                                                           Text="Search Vendors...."
                                                           Visibility="{Binding Text, ElementName=VendorSearchBox, Converter={StaticResource StringToVisibilityConverter}}"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>

                                                <!-- Search TextBox -->
                                                <TextBox x:Name="VendorSearchBox"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="12"
                                                         Foreground="{StaticResource InkBrush}"
                                                         VerticalContentAlignment="Center"
                                                         Padding="0"
                                                         TextChanged="VendorSearchBox_TextChanged"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Button Content="Export to Excel"
                                            Style="{StaticResource OutlineButton}"
                                            Padding="12,5"
                                            Height="34"
                                            FontSize="12.5"
                                            Margin="0,0,10,0"
                                            Click="ExportVendorsButton_Click"/>
                                    <Button Content="+ Add Vendor"
                                            Style="{StaticResource MiniButton}"
                                            Padding="14,5"
                                            Height="34"
                                            FontSize="12.5"
                                            Click="AddVendorButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{StaticResource LineBrush}"/>

                            <DataGrid x:Name="VendorsGrid"
