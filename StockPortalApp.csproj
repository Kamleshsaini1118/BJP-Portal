<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon></ApplicationIcon>
    <RootNamespace>StockPortalApp</RootNamespace>
    <AssemblyName>StockPortalApp</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);StockPortalAppV1\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQL Server connectivity -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- Lets us use App.config connection strings -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
