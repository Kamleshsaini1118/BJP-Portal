<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>StockPortalApp</RootNamespace>
    <AssemblyName>StockPortalApp</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);StockPortal.Core\**;StockPortal.Infrastructure\**;StockPortal.API\**</DefaultItemExcludes>
    <!-- Note: Win32 ApplicationIcon strictly requires a .ico format file (e.g. Assets\Images\bjp-logo.ico). Do not use .webp or .png here. -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\bjp-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="StockPortal.Core\StockPortal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL Server connectivity -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- Lets us use App.config connection strings -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
